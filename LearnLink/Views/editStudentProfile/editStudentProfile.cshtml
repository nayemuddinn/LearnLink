@model LearnLink.Models.User

@{
    ViewBag.Title = "Edit Student Profile";
    Layout = null;

    string userRole = Session["UserRole"] != null ? Session["UserRole"].ToString() : "";
    string userName = Session["UserName"] != null ? Session["UserName"].ToString() : "Guest";

}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Profile - LearnLink</title>

    <link href="@Url.Content("~/Content/EditStudentProfile.css")" rel="stylesheet" />

    <script type="module"
            src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>

    <script nomodule
            src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar">

        <div class="navbar-container">

            <div class="navbar-logo">

                <ion-icon name="school-outline"
                          class="logo-icon"></ion-icon>

                <div class="logo-text-group">

                    <span class="logo-text">
                        LearnLink
                    </span>

                    <span class="role-badge">
                        @userRole
                    </span>

                </div>

            </div>


            <div class="navbar-menu">

                <div class="nav-links">

                    <a href="@Url.Action("AllCourse", "AllCourse")"
                       class="nav-link">

                        <ion-icon name="book-outline"></ion-icon>

                        <span>All Courses</span>

                    </a>


                    <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")"
                       class="nav-link">

                        <ion-icon name="school-outline"></ion-icon>

                        <span>Enrolled Courses</span>

                    </a>


                    <a href="@Url.Action("Assessment", "Assessment")"
                       class="nav-link">

                        <ion-icon name="checkmark-circle-outline"></ion-icon>

                        <span>Assessments</span>

                    </a>


             

                </div>

            </div>


            <div class="navbar-user">

                <div class="user-info">

                    <ion-icon name="person-circle"
                              class="user-avatar"></ion-icon>

                    <span class="user-name">
                        @userName
                    </span>

                </div>


                <a href="@Url.Action("Logout", "Logout")"
                   class="logout-btn"
                   title="Log Out">

                    <ion-icon name="log-out-outline"></ion-icon>

                </a>

            </div>


            <div class="navbar-toggle">

                <span></span>
                <span></span>
                <span></span>

            </div>

        </div>

    </nav>


    <!-- ================= MAIN CONTENT ================= -->

    <main class="main-content">

        <div class="page-container">


            <!-- Page Header -->

            <div class="page-header-title">

                <h1>
                    Edit Your Profile
                </h1>

                <p>
                    Update your personal and academic information
                    to keep your profile current and accurate.
                </p>

            </div>


            <!-- Form -->

            <div class="form-wrapper">

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()


                    <!-- Success Message -->

                    if (ViewBag.SuccessMessage != null)
                    {
                        <div class="alert alert-success">

                            <ion-icon name="checkmark-circle-outline"></ion-icon>

                            <span>
                                @ViewBag.SuccessMessage
                            </span>

                        </div>
                    }


                    <!-- Error Message -->

                    if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-error">

                            <ion-icon name="alert-circle-outline"></ion-icon>

                            <span>
                                @ViewBag.ErrorMessage
                            </span>

                        </div>
                    }


                    <!-- ================= PERSONAL INFORMATION ================= -->

                    <div class="form-card">

                        <div class="card-header">

                            <div class="card-icon-wrapper">

                                <ion-icon name="person-outline"></ion-icon>

                            </div>


                            <div class="card-title-group">

                                <h2>
                                    Personal Information
                                </h2>

                                <p>
                                    Your basic contact details
                                </p>

                            </div>

                        </div>


                        <div class="card-body">


                            <!-- Full Name -->

                            <div class="form-group">

                                <div class="form-field-header">

                                    <label for="Name"
                                           class="form-label">

                                        Full Name

                                    </label>

                                    <span class="required-badge">
                                        Required
                                    </span>

                                </div>


                                @Html.EditorFor(
                                         m => m.Name,
                                         new
                                         {
                                             htmlAttributes = new
                                             {
                                                 @class = "form-input",
                                                 placeholder = "Enter your full name",
                                                 required = "required"
                                             }
                                         }
                                     )


                                @Html.ValidationMessageFor(
                                         m => m.Name,
                                         "",
                                         new
                                         {
                                             @class = "validation-error"
                                         }
                                     )

                            </div>


                            <!-- Email -->

                            <div class="form-group">

                                <div class="form-field-header">

                                    <label for="Email"
                                           class="form-label">

                                        Email Address

                                    </label>

                                    <span class="required-badge">
                                        Required
                                    </span>

                                </div>


                                @Html.EditorFor(
                                         m => m.Email,
                                         new
                                         {
                                             htmlAttributes = new
                                             {
                                                 @class = "form-input",
                                                 placeholder = "Enter your email address",
                                                 type = "email",
                                                 required = "required",
                                                 disabled = "disabled"
                                             }
                                         }
                                     )


                                @Html.ValidationMessageFor(
                                         m => m.Email,
                                         "",
                                         new
                                         {
                                             @class = "validation-error"
                                         }
                                     )

                            </div>


                            <!-- Phone -->

                            <div class="form-group">

                                <div class="form-field-header">

                                    <label for="Phone"
                                           class="form-label">

                                        Phone Number

                                    </label>

                                </div>


                                @Html.EditorFor(
                                         m => m.Phone,
                                         new
                                         {
                                             htmlAttributes = new
                                             {
                                                 @class = "form-input",
                                                 placeholder = "Enter your phone number"
                                             }
                                         }
                                     )


                                @Html.ValidationMessageFor(
                                         m => m.Phone,
                                         "",
                                         new
                                         {
                                             @class = "validation-error"
                                         }
                                     )

                            </div>

                        </div>

                    </div>


                    <!-- ================= ACADEMIC INFORMATION ================= -->

                    <div class="form-card">

                        <div class="card-header">

                            <div class="card-icon-wrapper">

                                <ion-icon name="school-outline"></ion-icon>

                            </div>


                            <div class="card-title-group">

                                <h2>
                                    Academic Details
                                </h2>

                                <p>
                                    Your academic and institutional information
                                </p>

                            </div>

                        </div>


                        <div class="card-body">


                            <!-- Address -->

                            <div class="form-group">

                                <div class="form-field-header">

                                    <label for="Address"
                                           class="form-label">

                                        Street Address

                                    </label>

                                    <span class="optional-badge">
                                        Optional
                                    </span>

                                </div>


                                @Html.EditorFor(
                                         m => m.Address,
                                         new
                                         {
                                             htmlAttributes = new
                                             {
                                                 @class = "form-input",
                                                 placeholder = "Enter your street address"
                                             }
                                         }
                                     )


                                @Html.ValidationMessageFor(
                                         m => m.Address,
                                         "",
                                         new
                                         {
                                             @class = "validation-error"
                                         }
                                     )

                            </div>


                            <!-- Institution -->

                            <div class="form-group">

                                <div class="form-field-header">

                                    <label for="Institution"
                                           class="form-label">

                                        School/University

                                    </label>

                                    <span class="optional-badge">
                                        Optional
                                    </span>

                                </div>


                                @Html.EditorFor(
                                         m => m.Institution,
                                         new
                                         {
                                             htmlAttributes = new
                                             {
                                                 @class = "form-input",
                                                 placeholder = "Enter your school or university name"
                                             }
                                         }
                                     )


                                @Html.ValidationMessageFor(
                                         m => m.Institution,
                                         "",
                                         new
                                         {
                                             @class = "validation-error"
                                         }
                                     )

                            </div>

                        </div>

                    </div>


                    <!-- ================= SECURITY SETTINGS ================= -->

                    <div class="form-card">

                        <div class="card-header">

                            <div class="card-icon-wrapper">

                                <ion-icon name="lock-closed-outline"></ion-icon>

                            </div>


                            <div class="card-title-group">

                                <h2>
                                    Change Password
                                </h2>

                                <p>
                                    Update your password to keep your account secure
                                </p>

                            </div>

                        </div>


                        <div class="card-body">


                            <!-- Current Password -->

                            <div class="form-group">

                                <div class="form-field-header">

                                    <label for="CurrentPassword"
                                           class="form-label">

                                        Current Password

                                    </label>

                                    <span class="optional-badge">
                                        Optional
                                    </span>

                                </div>


                                <input type="password"
                                       id="CurrentPassword"
                                       name="CurrentPassword"
                                       class="form-input"
                                       placeholder="Enter your current password" />


                            </div>


                            <!-- New Password -->

                            <div class="form-group">

                                <div class="form-field-header">

                                    <label for="NewPassword"
                                           class="form-label">

                                        New Password

                                    </label>

                                    <span class="optional-badge">
                                        Optional
                                    </span>

                                </div>


                                <input type="password"
                                       id="NewPassword"
                                       name="NewPassword"
                                       class="form-input"
                                       placeholder="Enter your new password" />


                            </div>


                            <!-- Confirm New Password -->

                            <div class="form-group">

                                <div class="form-field-header">

                                    <label for="ConfirmNewPassword"
                                           class="form-label">

                                        Confirm New Password

                                    </label>

                                    <span class="optional-badge">
                                        Optional
                                    </span>

                                </div>


                                <input type="password"
                                       id="ConfirmNewPassword"
                                       name="ConfirmNewPassword"
                                       class="form-input"
                                       placeholder="Confirm your new password" />


                            </div>

                        </div>

                    </div>


                    <!-- ================= ACTIONS ================= -->

                    <div class="form-actions">

                        <button type="submit"
                                class="btn btn-primary">

                            <ion-icon name="checkmark-circle-outline"></ion-icon>

                            <span>
                                Save Changes
                            </span>

                        </button>


                        <a href="@Url.Action("Dashboard", "StudentDashboard")"
                           class="btn btn-secondary">

                            <ion-icon name="arrow-back-outline"></ion-icon>

                            <span>
                                Cancel
                            </span>

                        </a>

                    </div>

                }

            </div>

        </div>

    </main>

</body>

</html>

                            <span>
                                Cancel
                            </span>

                        </a>

                    </div>
                }

            </div>

        </div>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="footer">

        <div class="footer-content">

            <p>
                &copy; 2024 LearnLink. All rights reserved.
            </p>

        </div>

    </footer>


    <script>

            // Mobile menu toggle
            document.querySelector('.navbar-toggle').addEventListener('click', function () {

                document.querySelector('.navbar-menu').classList.toggle('active');

            });

    </script>

</body>
</html>