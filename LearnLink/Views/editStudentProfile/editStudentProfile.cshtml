@model LearnLink.Models.User

@{
    ViewBag.Title = "Edit Student Profile";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile - LearnLink</title>
    <link href="@Url.Content("/Content/EditProfile.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>
    <!-- Professional Top Navbar -->
    <nav class="navbar">
        <div class="navbar-container">
            <!-- Logo -->
            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>
                <span class="logo-text">LearnLink</span>
            </div>

            <!-- Navigation Links -->
            <div class="navbar-menu">
                <div class="nav-links">
                    <a href="@Url.Action("AllCourse", "AllCourse")" class="nav-link">
                        <ion-icon name="book-outline"></ion-icon>
                        <span>All Courses</span>
                    </a>
                    <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")" class="nav-link">
                        <ion-icon name="school-outline"></ion-icon>
                        <span>Enrolled</span>
                    </a>
                    <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                        <ion-icon name="checkmark-circle-outline"></ion-icon>
                        <span>Assessments</span>
                    </a>
                </div>
            </div>

            <!-- User Profile & Logout -->
            <div class="navbar-user">
                <div class="user-info">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <div class="user-details">
                        <p class="user-name">@HttpContext.Current.Session["UserName"]</p>
                        <p class="user-role">@HttpContext.Current.Session["UserRole"]</p>
                    </div>
                </div>
                <a href="@Url.Action("login", "Login")" class="logout-btn" title="Log Out">
                    <ion-icon name="log-out-outline"></ion-icon>
                </a>
            </div>

            <!-- Mobile Menu Toggle -->
            <div class="navbar-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="main-content">
        <div class="page-container">
            <!-- Page Header -->
            <div class="page-header">
                <div class="header-content">
                    <div class="header-text">
                        <h1>Edit Your Profile</h1>
                        <p>Update your personal and academic information to keep your profile current and accurate.</p>
                    </div>
                    <div class="header-illustration">
                        <div class="illustration-box">
                            <ion-icon name="person-outline"></ion-icon>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Section -->
            <div class="form-wrapper">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()

                    <!-- Success/Error Messages -->
                    if (ViewBag.SuccessMessage != null)
                    {
                        <div class="alert alert-success">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            <span>@ViewBag.SuccessMessage</span>
                        </div>
                    }

                    if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-error">
                            <ion-icon name="alert-circle-outline"></ion-icon>
                            <span>@ViewBag.ErrorMessage</span>
                        </div>
                    }

                    <!-- Personal Information Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <div class="card-icon">
                                <ion-icon name="person-outline"></ion-icon>
                            </div>
                            <div class="card-title">
                                <h2>Personal Information</h2>
                                <p>Your basic contact details</p>
                            </div>
                        </div>

                        <div class="card-body">
                            <!-- Full Name -->
                            <div class="form-group">
                                <div class="form-field-header">
                                    <label for="Name" class="form-label">Full Name</label>
                                    <span class="required-badge">Required</span>
                                </div>
                                <div class="input-group">
                                    <ion-icon name="person-outline" class="input-icon-left"></ion-icon>
                                    @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @class = "form-input", placeholder = "Enter your full name", required = "required" } })
                                </div>
                                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "validation-error" })
                            </div>

                            <!-- Email -->
                            <div class="form-group">
                                <div class="form-field-header">
                                    <label for="Email" class="form-label">Email Address</label>
                                    <span class="required-badge">Required</span>
                                </div>
                                <div class="input-group">
                                    <ion-icon name="mail-outline" class="input-icon-left"></ion-icon>
                                    @Html.EditorFor(m => m.Email, new { htmlAttributes = new { @class = "form-input", placeholder = "Enter your email address", type = "email", required = "required" } })
                                </div>
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "validation-error" })
                            </div>

                            <!-- Phone Number -->
                            <div class="form-group">
                                <div class="form-field-header">
                                    <label for="Phone" class="form-label">Phone Number</label>
                                    <span class="optional-badge">Optional</span>
                                </div>
                                <div class="input-group">
                                    <ion-icon name="call-outline" class="input-icon-left"></ion-icon>
                                    @Html.EditorFor(m => m.Phone, new { htmlAttributes = new { @class = "form-input", placeholder = "Enter your phone number" } })
                                </div>
                                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "validation-error" })
                            </div>
                        </div>
                    </div>

                    <!-- Academic Information Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <div class="card-icon">
                                <ion-icon name="school-outline"></ion-icon>
                            </div>
                            <div class="card-title">
                                <h2>Academic Details</h2>
                                <p>Your academic and institutional information</p>
                            </div>
                        </div>

                        <div class="card-body">
                            <!-- Address -->
                            <div class="form-group">
                                <div class="form-field-header">
                                    <label for="Address" class="form-label">Street Address</label>
                                    <span class="optional-badge">Optional</span>
                                </div>
                                <div class="input-group">
                                    <ion-icon name="location-outline" class="input-icon-left"></ion-icon>
                                    @Html.EditorFor(m => m.Address, new { htmlAttributes = new { @class = "form-input", placeholder = "Enter your street address" } })
                                </div>
                                @Html.ValidationMessageFor(m => m.Address, "", new { @class = "validation-error" })
                            </div>

                            <!-- Institution -->
                            <div class="form-group">
                                <div class="form-field-header">
                                    <label for="Institution" class="form-label">School/University</label>
                                    <span class="optional-badge">Optional</span>
                                </div>
                                <div class="input-group">
                                    <ion-icon name="school-outline" class="input-icon-left"></ion-icon>
                                    @Html.EditorFor(m => m.Institution, new { htmlAttributes = new { @class = "form-input", placeholder = "Enter your school or university name" } })
                                </div>
                                @Html.ValidationMessageFor(m => m.Institution, "", new { @class = "validation-error" })
                            </div>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <ion-icon name="checkmark-done-outline"></ion-icon>
                            <span>Save Changes</span>
                        </button>
                        <a href="@Url.Action("Dashboard", "StudentDashboard")" class="btn btn-secondary">
                            <ion-icon name="arrow-back-outline"></ion-icon>
                            <span>Cancel</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2024 LearnLink. All rights reserved. Designed with care.</p>
        </div>
    </footer>

    <script>
        // Mobile menu toggle
        document.querySelector('.navbar-toggle').addEventListener('click', function() {
            document.querySelector('.navbar-menu').classList.toggle('active');
        });

        // Close mobile menu when clicking on a link
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', function() {
                document.querySelector('.navbar-menu').classList.remove('active');
            });
        });
    </script>
</body>
</html>

