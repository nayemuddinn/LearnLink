@{
    ViewBag.Title = "Upload Course Materials";
    string userRole = Session["UserRole"] != null ? Session["UserRole"].ToString() : "";
    string userName = Session["UserName"] != null ? Session["UserName"].ToString() : "Guest";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Course Materials - LearnLink</title>
    <link href="@Url.Content("~/Content/CourseMaterials.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>
    <!-- ================= NAVBAR ================= -->
    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>
                <div class="logo-text-group">
                    <span class="logo-text">LearnLink</span>
                    <span class="role-badge">@userRole</span>
                </div>
            </div>

            <div class="navbar-menu">
                <div class="nav-links">
                    @{
                        if (userRole.Equals("Student"))
                        {
                            <a href="@Url.Action("AllCourse", "AllCourse")" class="nav-link">
                                <ion-icon name="book-outline"></ion-icon>
                                <span>All Courses</span>
                            </a>
                            <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")" class="nav-link">
                                <ion-icon name="school-outline"></ion-icon>
                                <span>Enrolled Courses</span>
                            </a>
                            <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                                <ion-icon name="checkmark-circle-outline"></ion-icon>
                                <span>Assessments</span>
                            </a>
                            <a href="@Url.Action("editStudentProfile", "editStudentProfile")" class="nav-link">
                                <ion-icon name="person-outline"></ion-icon>
                                <span>Edit Profile</span>
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("ManageCourse", "ManageCourse")" class="nav-link">
                                <ion-icon name="book-outline"></ion-icon>
                                <span>Manage Courses</span>
                            </a>
                            <a href="@Url.Action("createCourse", "createCourse")" class="nav-link">
                                <ion-icon name="add-circle-outline"></ion-icon>
                                <span>Create Courses</span>
                            </a>
                            <a href="@Url.Action("courseMaterials", "courseMaterials")" class="nav-link active">
                                <ion-icon name="document-text-outline"></ion-icon>
                                <span>Course Materials</span>
                            </a>
                            <a href="@Url.Action("enrollStudents", "enrollStudents")" class="nav-link">
                                <ion-icon name="person-add-outline"></ion-icon>
                                <span>Enroll Students</span>
                            </a>
                            <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                                <ion-icon name="checkmark-circle-outline"></ion-icon>
                                <span>Assessments</span>
                            </a>
                        }
                    }
                </div>
            </div>

            <div class="navbar-user">
                <div class="user-info">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <span class="user-name">@userName</span>
                </div>
                <a href="@Url.Action("Logout", "Logout")" class="logout-btn">
                    <ion-icon name="exit-outline"></ion-icon>
                </a>
            </div>
        </div>
    </nav>

    <!-- ================= MAIN CONTENT ================= -->
    <div class="main-content">
        <div class="page-container">
            <div class="page-header-title">
                <h1>Upload Course Materials</h1>
                <p>Add learning resources to your courses</p>
            </div>

            <div class="glass-card" style="max-width: 700px; margin: 0 auto;">
                @using (Html.BeginForm("CourseMaterials", "courseMaterials", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    <div class="form-section">
                        <h3>
                            <ion-icon name="cloud-upload-outline"></ion-icon>
                            Upload New Material
                        </h3>

                        <!-- Course ID Form Group -->
                        <div class="form-group">
                            <label for="courseID">
                                Course ID
                                <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <ion-icon name="book-outline"></ion-icon>
                                @Html.TextBox("courseID", "", new { @class = "course-input", placeholder = "Enter course ID", required = "required" })
                            </div>
                        </div>

                        <!-- File Upload Form Group -->
                        <div class="form-group">
                            <label for="fileUpload">
                                Select File
                                <span>*</span>
                            </label>
                            <div class="drop-zone-wrapper">
                                <div id="dropZone">
                                    <input type="file" name="fileUpload" id="fileUpload" required accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt" />
                                    <div class="drop-zone-content">
                                        <ion-icon name="cloud-upload-outline"></ion-icon>
                                        <p>Drag and drop your file here</p>
                                        <p class="subtle">or click to browse</p>
                                        <p class="hint">PDF, DOC, PPT, XLS, TXT (Max 50MB)</p>
                                    </div>
                                </div>
                                <p id="fileName"></p>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="form-actions">
                            <button type="submit" class="upload-btn">
                                <ion-icon name="cloud-upload-outline"></ion-icon>
                                <span>Upload Material</span>
                            </button>
                            <a href="@Url.Action("ManageCourse", "ManageCourse")" class="cancel-btn">
                                <ion-icon name="arrow-back-outline"></ion-icon>
                                <span>Cancel</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ================= SCRIPTS ================= -->
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileUpload');
        const fileName = document.getElementById('fileName');

        // File selection via input
        fileInput.addEventListener('change', function () {
            if (this.files.length > 0) {
                fileName.textContent = '✓ ' + this.files[0].name + ' selected';
            } else {
                fileName.textContent = '';
            }
        });

        // Drag and drop events
        dropZone.addEventListener('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            this.classList.add('drag-active');
        });

        dropZone.addEventListener('dragleave', function (e) {
            e.preventDefault();
            e.stopPropagation();
            this.classList.remove('drag-active');
        });

        dropZone.addEventListener('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            this.classList.remove('drag-active');

            const files = e.dataTransfer.files;
            if (files.length > 0) {
                fileInput.files = files;
                fileName.textContent = '✓ ' + files[0].name + ' selected';
            }
        });

        // Click to browse
        dropZone.addEventListener('click', function (e) {
            if (e.target === this || e.target.closest('.drop-zone-content')) {
                fileInput.click();
            }
        });
    </script>
</body>
</html>
