@{
    ViewBag.Title = "Course Materials";
    Layout = null;

    string userRole = Session["UserRole"] != null
        ? Session["UserRole"].ToString()
        : "";

    string userName = Session["UserName"] != null
        ? Session["UserName"].ToString()
        : "Guest";

}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Course Materials - LearnLink</title>

    <link href="@Url.Content("~/Content/CourseMaterial.css")"
          rel="stylesheet" />

    <script type="module"
            src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>

    <script nomodule
            src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar">

        <div class="navbar-container">

            <!-- LOGO -->

            <div class="navbar-logo">

                <ion-icon name="school-outline"
                          class="logo-icon">
                </ion-icon>

                <div class="logo-text-group">

                    <span class="logo-text">
                        LearnLink
                    </span>

                    <span class="role-badge">
                        @userRole
                    </span>

                </div>

            </div>


            <!-- NAVIGATION -->

            <div class="navbar-menu">

                <div class="nav-links">

                    @if (userRole.Equals("Student"))
                    {
                        <a href="@Url.Action("AllCourse", "AllCourse")"
                           class="nav-link">

                            <ion-icon name="book-outline"></ion-icon>

                            <span>
                                All Courses
                            </span>

                        </a>

                        <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")"
                           class="nav-link">

                            <ion-icon name="school-outline"></ion-icon>

                            <span>
                                Enrolled Courses
                            </span>

                        </a>

                        <a href="@Url.Action("Assessment", "Assessment")"
                           class="nav-link">

                            <ion-icon name="checkmark-circle-outline"></ion-icon>

                            <span>
                                Assessments
                            </span>

                        </a>

                        <a href="@Url.Action("editStudentProfile", "editStudentProfile")"
                           class="nav-link">

                            <ion-icon name="person-outline"></ion-icon>

                            <span>
                                Edit Profile
                            </span>

                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("ManageCourse", "ManageCourse")"
                           class="nav-link">

                            <ion-icon name="book-outline"></ion-icon>

                            <span>
                                Manage Courses
                            </span>

                        </a>

                        <a href="@Url.Action("createCourse", "createCourse")"
                           class="nav-link">

                            <ion-icon name="add-circle-outline"></ion-icon>

                            <span>
                                Create Courses
                            </span>

                        </a>

                        <a href="@Url.Action("courseMaterials", "courseMaterials")"
                           class="nav-link active">

                            <ion-icon name="document-text-outline"></ion-icon>

                            <span>
                                Course Materials
                            </span>

                        </a>

                        <a href="@Url.Action("enrollStudents", "enrollStudents")"
                           class="nav-link">

                            <ion-icon name="person-add-outline"></ion-icon>

                            <span>
                                Enroll Students
                            </span>

                        </a>

                        <a href="@Url.Action("Assessment", "Assessment")"
                           class="nav-link">

                            <ion-icon name="checkmark-circle-outline"></ion-icon>

                            <span>
                                Assessments
                            </span>

                        </a>

                        <a href="@Url.Action("editteacherProfile", "editteacherProfile")"
                           class="nav-link">

                            <ion-icon name="person-outline"></ion-icon>

                            <span>
                                Edit Profile
                            </span>

                        </a>
                    }

                </div>

            </div>


            <!-- USER -->

            <div class="navbar-user">

                <div class="user-info">

                    <ion-icon name="person-circle"
                              class="user-avatar">
                    </ion-icon>

                    <span class="user-name">
                        @userName
                    </span>

                </div>

                <a href="@Url.Action("login", "Login")"
                   class="logout-btn"
                   title="Log Out">

                    <ion-icon name="log-out-outline"></ion-icon>

                </a>

            </div>


            <!-- MOBILE TOGGLE -->

            <div class="navbar-toggle">

                <span></span>
                <span></span>
                <span></span>

            </div>

        </div>

    </nav>


    <!-- ================= MAIN CONTENT ================= -->

    <main class="main-content">

        <div class="page-container">

            <!-- PAGE HEADER -->

            <div class="page-header-title">

                <h1>
                    Upload Course Materials
                </h1>

                <p>
                    Add learning resources to your course.
                </p>

            </div>


            <!-- ================= UPLOAD CARD ================= -->

            <div class="upload-card">

                <div class="upload-card-header">

                    <div class="upload-icon-wrapper">

                        <ion-icon name="cloud-upload-outline"></ion-icon>

                    </div>

                    <div>

                        <h2>
                            Material Upload
                        </h2>

                        <p>
                            Upload documents and learning resources for your course.
                        </p>

                    </div>

                </div>


                @using (Html.BeginForm(
                    "CourseMaterials",
                    "courseMaterials",
                    FormMethod.Post,
                    new { enctype = "multipart/form-data" }))
                {
                    <div class="form-section">

                        <!-- COURSE ID -->

                        <div class="form-group">

                            <label for="courseID">
                                Course ID
                            </label>

                            <div class="input-wrapper">

                                <ion-icon name="book-outline"
                                          class="input-icon">
                                </ion-icon>

                                @Html.TextBox(
                                         "courseID",
                                         "",
                                         new
                                         {
                                             @class = "form-control",
                                             placeholder = "Enter course ID",
                                             required = "required"
                                         })

                            </div>

                        </div>


                        <!-- FILE -->

                        <div class="form-group">

                            <label for="fileUpload">
                                Select File
                            </label>

                            <div class="file-upload-area">

                                <input type="file"
                                       name="fileUpload"
                                       id="fileUpload"
                                       required
                                       accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt" />

                                <div class="file-upload-content">

                                    <ion-icon name="cloud-upload-outline"
                                              class="file-upload-icon">
                                    </ion-icon>

                                    <h3>
                                        Drag and drop your file here
                                    </h3>

                                    <p>
                                        or click to browse
                                    </p>

                                    <span>
                                        PDF, DOC, DOCX, PPT, PPTX, XLS, XLSX, TXT
                                    </span>

                                </div>

                            </div>

                            <div class="file-size-info">

                                <ion-icon name="information-circle-outline"></ion-icon>

                                <span>
                                    Maximum file size: 50MB
                                </span>

                            </div>

                            <div id="selectedFile"
                                 class="selected-file">

                                <ion-icon name="document-outline"></ion-icon>

                                <span id="selectedFileName"></span>

                            </div>

                        </div>

                    </div>


                    <!-- ACTIONS -->

                    <div class="form-actions">

                        <button type="submit"
                                class="btn-upload">

                            <ion-icon name="cloud-upload-outline"></ion-icon>

                            <span>
                                Upload Material
                            </span>

                        </button>

                        <a href="@Url.Action("ManageCourse", "ManageCourse")"
                           class="btn-cancel">

                            <ion-icon name="arrow-back-outline"></ion-icon>

                            <span>
                                Cancel
                            </span>

                        </a>

                    </div>
                }

            </div>


            <!-- BACK -->

            <div class="back-action">

                <button type="button"
                        class="btn-back"
                        onclick="window.location.href='@Url.Action("ManageCourse", "ManageCourse")'">

                    <ion-icon name="arrow-back-outline"></ion-icon>

                    <span>
                        Back to Manage Courses
                    </span>

                </button>

            </div>

        </div>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="footer">

        <div class="footer-content">

            <p>
                &copy; 2026 LearnLink. All rights reserved.
            </p>

        </div>

    </footer>


    <!-- ================= JAVASCRIPT ================= -->

    <script>

            /* ================= NAVBAR ================= */

            document
                .querySelector('.navbar-toggle')
                .addEventListener('click', function () {

                    document
                        .querySelector('.navbar-menu')
                        .classList
                        .toggle('active');

                });


            /* ================= FILE SELECTION ================= */

            document
                .getElementById('fileUpload')
                .addEventListener('change', function () {

                    var selectedFile = document.getElementById('selectedFile');
                    var selectedFileName = document.getElementById('selectedFileName');

                    if (this.files && this.files.length > 0) {

                        selectedFileName.textContent = this.files[0].name;

                        selectedFile.classList.add('active');

                    }
                    else {

                        selectedFile.classList.remove('active');

                        selectedFileName.textContent = '';

                    }

                });


            /* ================= DRAG & DROP VISUAL EFFECT ================= */

            var fileUploadArea =
                document.querySelector('.file-upload-area');

            var fileInput =
                document.getElementById('fileUpload');


            fileUploadArea.addEventListener('dragover', function (event) {

                event.preventDefault();

                fileUploadArea.classList.add('drag-over');

            });


            fileUploadArea.addEventListener('dragleave', function () {

                fileUploadArea.classList.remove('drag-over');

            });


            fileUploadArea.addEventListener('drop', function () {

                fileUploadArea.classList.remove('drag-over');

            });

    </script>

</body>
</html>