@using LearnLink.Models;

@{
    var alertMessage = TempData["AlertMessage"] as string;
}

<!-- View uses shared layout (do not include <head> or <html> here) -->
<main class="auth-container">

    <div class="auth-content">
        <!-- Left Section: Welcome/Branding -->
        <div class="auth-left-section">
            <div class="auth-branding">
                <h1>Join LearnLink</h1>
                <p>Start Your Learning Journey Today</p>
                <div class="auth-features">
                    <div class="feature-item">
                        <ion-icon name="flash-outline"></ion-icon>
                        <span>Quick Registration</span>
                    </div>
                    <div class="feature-item">
                        <ion-icon name="shield-checkmark-outline"></ion-icon>
                        <span>Secure & Private</span>
                    </div>
                    <div class="feature-item">
                        <ion-icon name="people-outline"></ion-icon>
                        <span>Join a Community</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Section: Form -->
        <div class="auth-right-section">
            <div class="auth-form-container">
                <!-- Role Selection Toggle -->
                <div class="auth-role-selector">
                    <p class="role-label">Register as</p>
                    <div class="role-toggle-container">
                        <input type="radio" id="role-teacher" name="Role" value="teacher" checked>
                        <label for="role-teacher" class="role-toggle-btn">
                            <ion-icon name="school-outline"></ion-icon>
                            <span>Teacher</span>
                        </label>

                        <input type="radio" id="role-student" name="Role" value="student">
                        <label for="role-student" class="role-toggle-btn">
                            <ion-icon name="person-outline"></ion-icon>
                            <span>Student</span>
                        </label>
                    </div>
                </div>

                <!-- Form -->
                <form action="" method="post" class="auth-form reg-form">
                    <h2>Create Your Account</h2>

                    <!-- Personal Information Section -->
                    <div class="form-section">
                        <h3 class="section-title">Personal Information</h3>
                        <div class="form-row">
                            <div class="form-group form-group-half">
                                <label for="Name">Full Name</label>
                                <div class="input-wrapper">
                                    <span class="input-icon"><ion-icon name="person-outline"></ion-icon></span>
                                    <input type="text" id="Name" name="Name" placeholder="John Doe" required>
                                </div>
                            </div>
                            <div class="form-group form-group-half">
                                <label for="Email">Email Address</label>
                                <div class="input-wrapper">
                                    <span class="input-icon"><ion-icon name="mail-outline"></ion-icon></span>
                                    <input type="email" id="Email" name="Email" placeholder="you@example.com" required>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Account Security Section -->
                    <div class="form-section">
                        <h3 class="section-title">Account Security</h3>
                        <div class="form-row">
                            <div class="form-group form-group-half">
                                <label for="Password">Password</label>
                                <div class="input-wrapper">
                                    <span class="input-icon"><ion-icon name="lock-closed-outline"></ion-icon></span>
                                    <input type="password" id="Password" name="Password" placeholder="Create a strong password" required>
                                </div>
                            </div>
                            <div class="form-group form-group-half">
                                <label for="ConfirmPassword">Confirm Password</label>
                                <div class="input-wrapper">
                                    <span class="input-icon"><ion-icon name="lock-closed-outline"></ion-icon></span>
                                    <input type="password" id="ConfirmPassword" name="ConfirmPassword" placeholder="Re-enter your password" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group form-group-half">
                                <label for="PIN">Personal PIN</label>
                                <div class="input-wrapper">
                                    <span class="input-icon"><ion-icon name="key-outline"></ion-icon></span>
                                    <input type="password" id="PIN" name="PIN" placeholder="4-6 digit PIN" required>
                                </div>
                            </div>
                            <div class="form-group form-group-half">
                                <label for="ConfirmPIN">Confirm PIN</label>
                                <div class="input-wrapper">
                                    <span class="input-icon"><ion-icon name="key-outline"></ion-icon></span>
                                    <input type="password" id="ConfirmPIN" name="ConfirmPIN" placeholder="Re-enter your PIN" required>
                                </div>
                            </div>
                        </div>
                        <p class="section-hint">Your PIN helps you recover your account if you forget your password</p>
                    </div>

                    <!-- Contact & Institution Section -->
                    <div class="form-section">
                        <h3 class="section-title">Contact & Institution</h3>
                        <div class="form-row">
                            <div class="form-group form-group-half">
                                <label for="Phone">Phone Number</label>
                                <div class="input-wrapper">
                                    <span class="input-icon"><ion-icon name="call-outline"></ion-icon></span>
                                    <input type="text" id="Phone" name="Phone" placeholder="+1 (555) 123-4567" required>
                                </div>
                            </div>
                            <div class="form-group form-group-half">
                                <label for="Institution">Institution</label>
                                <div class="input-wrapper">
                                    <span class="input-icon"><ion-icon name="school-outline"></ion-icon></span>
                                    <input type="text" id="Institution" name="Institution" placeholder="Your School/University" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="Address">Address</label>
                                <div class="input-wrapper">
                                    <span class="input-icon"><ion-icon name="home-outline"></ion-icon></span>
                                    <input type="text" id="Address" name="Address" placeholder="Street, City, State" required>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" name="Register" class="btn-primary">Create Account</button>
                </form>

                <!-- Login Link -->
                <div class="auth-footer-link">
                    <p>Already have an account? <a href="@Url.Action("login", "Login")">Sign in here</a></p>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
