@using LearnLink.Models

<main class="auth-container">
    <div class="auth-content">

        <!-- Left Section: Welcome / Branding -->
        <div class="auth-left-section">
            <div class="auth-branding">

                <h1>LearnLink</h1>
                <p>Connect, Learn, and Grow</p>

                <div class="auth-features">

                    <div class="feature-item">
                        <ion-icon name="checkmark-circle-outline"></ion-icon>
                        <span>Seamless Learning</span>
                    </div>

                    <div class="feature-item">
                        <ion-icon name="checkmark-circle-outline"></ion-icon>
                        <span>Collaborative Platform</span>
                    </div>

                    <div class="feature-item">
                        <ion-icon name="checkmark-circle-outline"></ion-icon>
                        <span>Accessible Anywhere</span>
                    </div>

                </div>

            </div>
        </div>


        <!-- Right Section: Registration Form -->
        <div class="auth-right-section">

            <div class="auth-form-container">

                <form action="@Url.Action("reg", "Registration")"
                      method="post"
                      class="auth-form reg-form"
                      id="registrationForm"
                      novalidate>

                    <h2>Create Your Account</h2>


                    <!-- ROLE SELECTION -->
                    <div class="auth-role-selector">

                        <p class="role-label">Register as</p>

                        <div class="role-toggle-container">

                            <input type="radio"
                                   id="role-teacher"
                                   name="Role"
                                   value="teacher"
                                   checked>

                            <label for="role-teacher"
                                   class="role-toggle-btn">

                                <ion-icon name="school-outline"></ion-icon>
                                <span>Teacher</span>

                            </label>


                            <input type="radio"
                                   id="role-student"
                                   name="Role"
                                   value="student">

                            <label for="role-student"
                                   class="role-toggle-btn">

                                <ion-icon name="person-outline"></ion-icon>
                                <span>Student</span>

                            </label>

                        </div>

                    </div>


                    <!-- PERSONAL INFORMATION -->
                    <div class="form-section">

                        <h3 class="section-title">
                            Personal Information
                        </h3>

                        <div class="form-row">

                            <!-- Name -->
                            <div class="form-group form-group-half">

                                <label for="Name">
                                    Full Name
                                </label>

                                <div class="input-wrapper">

                                    <span class="input-icon">
                                        <ion-icon name="person-outline"></ion-icon>
                                    </span>

                                    <input type="text"
                                           id="Name"
                                           name="Name"
                                           placeholder="John Doe">

                                </div>

                                <span class="field-error"
                                      id="nameError"></span>

                            </div>


                            <!-- Email -->
                            <div class="form-group form-group-half">

                                <label for="Email">
                                    Email Address
                                </label>

                                <div class="input-wrapper">

                                    <span class="input-icon">
                                        <ion-icon name="mail-outline"></ion-icon>
                                    </span>

                                    <input type="email"
                                           id="Email"
                                           name="Email"
                                           placeholder="you@example.com">

                                </div>

                                <span class="field-error"
                                      id="emailError"></span>

                            </div>

                        </div>

                    </div>


                    <!-- ACCOUNT SECURITY -->
                    <div class="form-section">

                        <h3 class="section-title">
                            Account Security
                        </h3>

                        <div class="form-row">

                            <!-- Password -->
                            <div class="form-group form-group-half">

                                <label for="Password">
                                    Password
                                </label>

                                <div class="input-wrapper">

                                    <span class="input-icon">
                                        <ion-icon name="lock-closed-outline"></ion-icon>
                                    </span>

                                    <input type="password"
                                           id="Password"
                                           name="Password"
                                           placeholder="Create a strong password">

                                </div>

                                <span class="field-error"
                                      id="passwordError"></span>

                            </div>


                            <!-- Confirm Password -->
                            <div class="form-group form-group-half">

                                <label for="ConfirmPassword">
                                    Confirm Password
                                </label>

                                <div class="input-wrapper">

                                    <span class="input-icon">
                                        <ion-icon name="lock-closed-outline"></ion-icon>
                                    </span>

                                    <input type="password"
                                           id="ConfirmPassword"
                                           name="ConfirmPassword"
                                           placeholder="Re-enter your password">

                                </div>

                                <span class="field-error"
                                      id="confirmPasswordError"></span>

                            </div>

                        </div>

                    </div>


                    <!-- CONTACT & INSTITUTION -->
                    <div class="form-section">

                        <h3 class="section-title">
                            Contact & Institution
                        </h3>

                        <div class="form-row">

                            <!-- Phone -->
                            <div class="form-group form-group-half">

                                <label for="Phone">
                                    Phone Number
                                </label>

                                <div class="input-wrapper">

                                    <span class="input-icon">
                                        <ion-icon name="call-outline"></ion-icon>
                                    </span>

                                    <input type="text"
                                           id="Phone"
                                           name="Phone"
                                           placeholder="01XXXXXXXXX">

                                </div>

                                <span class="field-error"
                                      id="phoneError"></span>

                            </div>


                            <!-- Institution -->
                            <div class="form-group form-group-half">

                                <label for="Institution">
                                    Institution
                                </label>

                                <div class="input-wrapper">

                                    <span class="input-icon">
                                        <ion-icon name="school-outline"></ion-icon>
                                    </span>

                                    <input type="text"
                                           id="Institution"
                                           name="Institution"
                                           placeholder="Your School/University">

                                </div>

                                <span class="field-error"
                                      id="institutionError"></span>

                            </div>

                        </div>


                        <!-- Address -->
                        <div class="form-row">

                            <div class="form-group">

                                <label for="Address">
                                    Address
                                </label>

                                <div class="input-wrapper">

                                    <span class="input-icon">
                                        <ion-icon name="home-outline"></ion-icon>
                                    </span>

                                    <input type="text"
                                           id="Address"
                                           name="Address"
                                           placeholder="Street, City, State">

                                </div>

                                <span class="field-error"
                                      id="addressError"></span>

                            </div>

                        </div>

                    </div>


                    <!-- SUBMIT -->
                    <button type="submit"
                            class="btn-primary"
                            id="registerButton">

                        Create Account

                    </button>

                </form>


                <!-- Login Link -->
                <div class="auth-footer-link">

                    <p>
                        Already have an account?

                        <a href="@Url.Action("Login", "Login")">
                            Sign in
                        </a>
                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- Toast Notification -->
    <div id="glass-toast" class="glass-toast">
        <ion-icon name="checkmark-circle"></ion-icon>
        <span class="toast-msg" id="toastMessage"></span>
        <button class="toast-close" onclick="closeRegistrationPopup()">
            <ion-icon name="close"></ion-icon>
        </button>
    </div>
</main>


<!-- Registration JavaScript -->
<script src="@Url.Content("~/Scripts/registration.js")"></script>
