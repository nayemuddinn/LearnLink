@model List<LearnLink.Models.Course>

@{
    ViewBag.Title = "Enrolled Courses";
    Layout = null;

    string userRole = Session["UserRole"] != null
        ? Session["UserRole"].ToString()
        : "";

    string userName = Session["UserName"] != null
        ? Session["UserName"].ToString()
        : "Guest";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enrolled Courses - LearnLink</title>

    <link href="@Url.Content("/Content/ViewEnrolledCourses.css")" rel="stylesheet" />

    <script type="module"
            src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule
            src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar">

        <div class="navbar-container">

            <div class="navbar-logo">

                <ion-icon name="school-outline"
                          class="logo-icon">
                </ion-icon>

                <div class="logo-text-group">

                    <span class="logo-text">
                        LearnLink
                    </span>

                    <span class="role-badge">
                        @userRole
                    </span>

                </div>

            </div>

            <div class="navbar-menu">

                <div class="nav-links">

                    @if (userRole.Equals("Student"))
                    {
                        <a href="@Url.Action("AllCourse", "AllCourse")"
                           class="nav-link">

                            <ion-icon name="book-outline"></ion-icon>

                            <span>All Courses</span>

                        </a>

                        <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")"
                           class="nav-link active">

                            <ion-icon name="school-outline"></ion-icon>

                            <span>Enrolled Courses</span>

                        </a>

                        <a href="@Url.Action("Assessment", "Assessment")"
                           class="nav-link">

                            <ion-icon name="checkmark-circle-outline"></ion-icon>

                            <span>Assessments</span>

                        </a>

                        <a href="@Url.Action("editStudentProfile", "editStudentProfile")"
                           class="nav-link">

                            <ion-icon name="person-outline"></ion-icon>

                            <span> Profile</span>

                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("ManageCourse", "ManageCourse")"
                           class="nav-link">

                            <ion-icon name="book-outline"></ion-icon>

                            <span>Manage Courses</span>

                        </a>

                        <a href="@Url.Action("createCourse", "createCourse")"
                           class="nav-link">

                            <ion-icon name="add-circle-outline"></ion-icon>

                            <span>Create Courses</span>

                        </a>

                        <a href="@Url.Action("courseMaterials", "courseMaterials")"
                           class="nav-link">

                            <ion-icon name="document-text-outline"></ion-icon>

                            <span>Upload Materials</span>

                        </a>

                        <a href="@Url.Action("enrollStudents", "enrollStudents")"
                           class="nav-link">

                            <ion-icon name="person-add-outline"></ion-icon>

                            <span>Enroll Students</span>

                        </a>

                        <a href="@Url.Action("Assessment", "Assessment")"
                           class="nav-link">

                            <ion-icon name="checkmark-circle-outline"></ion-icon>

                            <span>Assessments</span>

                        </a>

                        <a href="@Url.Action("editteacherProfile", "editteacherProfile")"
                           class="nav-link">

                            <ion-icon name="person-outline"></ion-icon>

                            <span> Profile</span>

                        </a>
                    }

                </div>

            </div>

            <div class="navbar-user">

                <div class="user-info">

                    <ion-icon name="person-circle"
                              class="user-avatar">
                    </ion-icon>

                    <span class="user-name">
                        @userName
                    </span>

                </div>

                <a href="@Url.Action("Logout", "Logout")"
                   class="logout-btn"
                   title="Log Out">

                    <ion-icon name="log-out-outline"></ion-icon>

                </a>

            </div>

        </div>

    </nav>


    <!-- ================= MAIN CONTENT ================= -->

    <main class="main-content">

        <div class="page-container">

            <div class="page-header-title">

                <h1>
                    Enrolled Courses
                </h1>

                <p>
                    View all courses you are currently enrolled in.
                </p>

            </div>


            <!-- ================= SEARCH ================= -->

            @if (Model != null && Model.Any())
            {
                <div class="search-section">

                    <div class="search-input-group">

                        <ion-icon name="search-outline"
                                  class="search-icon">
                        </ion-icon>

                        <input type="text"
                               id="courseSearch"
                               placeholder="Search courses by ID, name or instructor..."
                               class="search-input"
                               autocomplete="off" />

                    </div>

                </div>
            }


            <!-- ================= COURSE CARDS ================= -->

            <div class="tiles-grid">

                @if (Model == null || Model.Count == 0)
                {
                    <div class="empty-state">

                        <ion-icon name="book-outline"></ion-icon>

                        <h3>
                            No Courses Enrolled
                        </h3>

                        <p>
                            You are not yet enrolled in any courses. Browse available courses to get started.
                        </p>

                        <a href="@Url.Action("AllCourse", "AllCourse")"
                           class="btn-action btn-start">
                            <ion-icon name="book-outline"></ion-icon>
                            <span>Browse Courses</span>
                        </a>

                    </div>
                }
                else
                {
                    foreach (var course in Model)
                    {
                        <article class="glass-card">

                            <!-- Card Header -->

                            <div class="card-header">

                                <div class="card-icon-wrapper">

                                    <ion-icon name="book-outline"></ion-icon>

                                </div>

                                <div class="card-titles">

                                    <h3>@course.CourseName</h3>

                                </div>

                            </div>


                            <!-- Course Meta -->

                            <div class="quiz-meta">

                                <div>

                                    <span class="meta-label">Course ID:</span>

                                    <span>#@course.CourseID</span>

                                </div>

                                <div>

                                    <span class="meta-label">Instructor:</span>

                                    <span>@course.TeacherName</span>

                                </div>

                            </div>


                            <!-- Card Body -->

                            <div class="card-body">

                            </div>


                            <!-- Card Actions -->

                            <div class="card-actions">

                                <a href="@Url.Action("ShowCourseMate", "StudentEnrolledCourses", new { courseID = course.CourseID })"
                                   class="btn-action btn-start">

                                    <ion-icon name="document-text-outline"></ion-icon>

                                    <span>View Materials</span>

                                </a>

                                <a href="@Url.Action("Unenroll", "StudentEnrolledCourses", new { courseID = course.CourseID })"
                                   class="btn-action btn-unenroll"
                                   onclick="return confirm('Are you sure you want to unenroll from this course?');">

                                    <ion-icon name="close-outline"></ion-icon>

                                    <span>Unenroll</span>

                                </a>

                            </div>

                        </article>
                    }
                }

            </div>

        </div>

    </main>

</body>

</html>
