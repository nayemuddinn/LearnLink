@model LearnLink.Models.Quiz

@{
    ViewBag.Title = "Quiz - " + Model.Title;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Title - LearnLink</title>
    <link href="@Url.Content("/Content/StartQuiz.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>
    <!-- Professional Top Navbar -->
    <nav class="navbar">
        <div class="navbar-container">
            <!-- Logo -->
            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>
                <span class="logo-text">LearnLink</span>
            </div>

            <!-- Quiz Title in Center -->
            <div class="quiz-title-center">
                <h2>@Model.Title</h2>
            </div>

            <!-- User Profile & Logout -->
            <div class="navbar-user">
                <div class="user-info">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <div class="user-details">
                        <p class="user-name">@HttpContext.Current.Session["UserName"]</p>
                        <p class="user-role">Student</p>
                    </div>
                </div>
                <a href="@Url.Action("ViewQuizzes", "StudentViewQuizzes")" class="exit-btn" title="Exit Quiz">
                    <ion-icon name="exit-outline"></ion-icon>
                </a>
            </div>

            <!-- Mobile Menu Toggle -->
            <div class="navbar-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- Timer Bar (Sticky Below Navbar) -->
    <div class="timer-bar">
        <div class="timer-container">
            <div class="timer-label">
                <ion-icon name="time-outline"></ion-icon>
                <span>Time Remaining</span>
            </div>
            <div class="timer-display" id="timerDisplay">00:00</div>
            <div class="timer-status" id="timerStatus">Active</div>
        </div>
    </div>

    <!-- Main Content Area -->
    <main class="main-content">
        <div class="quiz-container">
            <!-- Quiz Header -->
            <div class="quiz-header">
                <div class="header-info">
                    <h1>@Model.Title</h1>
                    if (Model.Questions != null && Model.Questions.Count > 0)
                    {
                        <p>Answer all @Model.Questions.Count questions</p>
                    }
                </div>
                <div class="progress-info">
                    <div class="progress-label">Questions: <span id="currentQuestion">0</span> / <span id="totalQuestions">@(Model.Questions?.Count ?? 0)</span></div>
                    <div class="progress-bar">
                        <div class="progress-fill" id="progressFill"></div>
                    </div>
                </div>
            </div>

            <!-- Quiz Form -->
            if (Model.Questions != null && Model.Questions.Count > 0)
            {
                <form action="@Url.Action("SubmitQuiz", "StudentViewQuizzes")" method="post" id="quizForm">
                    <input type="hidden" name="quizID" value="@Model.QuizID" />

                    <div class="questions-container">
                        @foreach (var question in Model.Questions)
                        {
                            <div class="question-card" data-question-id="@question.QuestionID">
                                <div class="question-header">
                                    <div class="question-number">
                                        <span>Q@(Model.Questions.IndexOf(question) + 1)</span>
                                    </div>
                                    <div class="question-text">
                                        <h3>@question.QuestionText</h3>
                                    </div>
                                </div>

                                <div class="options-container">
                                    @{
                                        var options = new[] { question.OptionA, question.OptionB, question.OptionC, question.OptionD };
                                        var optionLabels = new[] { "A", "B", "C", "D" };

                                        for (int i = 0; i < options.Length; i++)
                                        {
                                            <div class="option-wrapper">
                                                <input type="radio" 
                                                       id="q@(question.QuestionID)_option@(optionLabels[i])" 
                                                       name="question_@question.QuestionID" 
                                                       value="@optionLabels[i]" 
                                                       class="option-input"
                                                       required
                                                       onchange="updateProgress()">
                                                <label for="q@(question.QuestionID)_option@(optionLabels[i])" class="option-label">
                                                    <span class="option-letter">@optionLabels[i]</span>
                                                    <span class="option-text">@options[i]</span>
                                                </label>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Form Actions -->
                    <div class="quiz-actions">
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            <span>Submit Quiz</span>
                        </button>
                        <a href="@Url.Action("ViewQuizzes", "StudentViewQuizzes")" class="btn btn-secondary">
                            <ion-icon name="arrow-back-outline"></ion-icon>
                            <span>Cancel Quiz</span>
                        </a>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-info">
                    <ion-icon name="information-circle-outline"></ion-icon>
                    <span>No questions available for this quiz yet.</span>
                </div>
            }
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2024 LearnLink. All rights reserved. Quiz Platform</p>
        </div>
    </footer>

    <script>
        // Initialize progress tracker
        function updateProgress() {
            var totalQuestions = @(Model.Questions?.Count ?? 0);
            var answeredQuestions = 0;

            for (let i = 1; i <= totalQuestions; i++) {
                var questionAnswered = document.querySelector('input[name^="question_"]:checked');
                if (questionAnswered) answeredQuestions++;
            }

            document.getElementById('currentQuestion').textContent = answeredQuestions;
            var percentage = (answeredQuestions / totalQuestions) * 100;
            document.getElementById('progressFill').style.width = percentage + '%';
        }

        // Timer functionality
        document.addEventListener('DOMContentLoaded', function() {
            var endTime = new Date('@HttpContext.Current.Session["QuizEndtime"]').getTime();

            function updateTimer() {
                var now = new Date().getTime();
                var timeLeft = endTime - now;

                if (timeLeft <= 0) {
                    document.getElementById('timerDisplay').textContent = '00:00';
                    document.getElementById('timerStatus').textContent = 'Time\'s Up!';
                    document.getElementById('timerStatus').style.color = '#ef4444';
                    document.getElementById('submitBtn').click();
                    return;
                }

                var minutes = Math.floor(timeLeft / 60000);
                var seconds = Math.floor((timeLeft % 60000) / 1000);

                var displayText = (minutes < 10 ? '0' : '') + minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
                document.getElementById('timerDisplay').textContent = displayText;

                var timerBar = document.querySelector('.timer-bar');
                var timerStatus = document.getElementById('timerStatus');

                if (timeLeft <= 300000) { // 5 minutes
                    timerBar.classList.add('critical');
                    timerStatus.textContent = 'Critical!';
                }
                if (timeLeft <= 60000) { // 1 minute
                    timerBar.classList.add('warning');
                }

                setTimeout(updateTimer, 1000);
            }

            updateTimer();
            updateProgress();
        });

        // Mobile menu toggle
        document.querySelector('.navbar-toggle').addEventListener('click', function() {
            document.querySelector('.navbar-menu').classList.toggle('active');
        });
    </script>
</body>
</html>
