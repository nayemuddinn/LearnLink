@model List<LearnLink.Models.QuizQuestion>

@{
    ViewBag.Title = "Start Quiz";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Start Quiz - LearnLink</title>

    <link href="@Url.Content("/Content/StartQuiz.css")" rel="stylesheet" />

    <script type="module"
            src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>

    <script nomodule
            src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    ```

</head>

<body>
    <!-- Professional Top Navbar -->
    <nav class="navbar">
        <div class="navbar-container">

            <!-- Logo -->
            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>
                <span class="logo-text">LearnLink</span>
            </div>

            <!-- Quiz Title -->
            <div class="quiz-title-center">
                <h2>Start A Quiz</h2>
            </div>

            <!-- User Profile & Logout -->
            <div class="navbar-user">

                <div class="user-info">

                    <ion-icon name="person-circle"
                              class="user-avatar"></ion-icon>

                    <div class="user-details">
                        <p class="user-name">
                            @HttpContext.Current.Session["UserName"]
                        </p>

                        <p class="user-role">
                            Student
                        </p>
                    </div>

                </div>

                <a href="@Url.Action("ViewQuizzes", "StudentViewQuizzes")"
                   class="exit-btn"
                   title="Exit Quiz">

                    <ion-icon name="exit-outline"></ion-icon>

                </a>

            </div>

        </div>
    </nav>


    <!-- Timer Bar -->
    <div class="timer-bar">

        <div class="timer-container">

            <div class="timer-label">

                <ion-icon name="time-outline"></ion-icon>

                <span>Time Remaining</span>

            </div>

            <div class="timer-display"
                 id="timerDisplay">

                00:00

            </div>

            <div class="timer-status"
                 id="timerStatus">

                Active

            </div>

        </div>

    </div>


    <!-- Main Content -->
    <main class="main-content">

        <div class="quiz-container">

            <!-- Quiz Header -->
            <div class="quiz-header">

                <div class="header-info">

                    <h1>Quiz</h1>

                    @if (Model != null && Model.Count > 0)
                    {
                        <p>
                            Answer all @Model.Count questions
                        </p>
                    }

                </div>


                <div class="progress-info">

                    <div class="progress-label">

                        Questions:

                        <span id="currentQuestion">0</span>

                        /

                        <span id="totalQuestions">
                            @(Model?.Count ?? 0)
                        </span>

                    </div>

                    <div class="progress-bar">

                        <div class="progress-fill"
                             id="progressFill">
                        </div>

                    </div>

                </div>

            </div>


            <!-- Quiz Form -->

            @if (Model != null && Model.Count > 0)
            {
                using (Html.BeginForm(
                    "SubmitQuiz",
                    "StudentViewQuizzes",
                    FormMethod.Post,
                    new { id = "quizForm" }))
                {

                    <div class="questions-container">

                        @{
                            int questionNumber = 1;
                        }

                        @foreach (var question in Model)
                        {

                            <div class="question-card"
                                 data-question-id="@question.QuestionID">

                                <div class="question-header">

                                    <div class="question-number">

                                        <span>
                                            @questionNumber
                                        </span>

                                    </div>

                                    <div class="question-text">

                                        <h3>
                                            @question.Question
                                        </h3>

                                    </div>

                                </div>


                                <div class="options-container">

                                    <div class="option-wrapper">

                                        <input type="radio"
                                               id="q@(question.QuestionID)_optionA"
                                               name="question_@question.QuestionID"
                                               value="A"
                                               class="option-input"
                                               required
                                               onchange="updateProgress()">

                                        <label for="q@(question.QuestionID)_optionA"
                                               class="option-label">

                                            <span class="option-letter">
                                                A
                                            </span>

                                            <span class="option-text">
                                                @question.OptionA
                                            </span>

                                        </label>

                                    </div>


                                    <div class="option-wrapper">

                                        <input type="radio"
                                               id="q@(question.QuestionID)_optionB"
                                               name="question_@question.QuestionID"
                                               value="B"
                                               class="option-input"
                                               required
                                               onchange="updateProgress()">

                                        <label for="q@(question.QuestionID)_optionB"
                                               class="option-label">

                                            <span class="option-letter">
                                                B
                                            </span>

                                            <span class="option-text">
                                                @question.OptionB
                                            </span>

                                        </label>

                                    </div>


                                    <div class="option-wrapper">

                                        <input type="radio"
                                               id="q@(question.QuestionID)_optionC"
                                               name="question_@question.QuestionID"
                                               value="C"
                                               class="option-input"
                                               required
                                               onchange="updateProgress()">

                                        <label for="q@(question.QuestionID)_optionC"
                                               class="option-label">

                                            <span class="option-letter">
                                                C
                                            </span>

                                            <span class="option-text">
                                                @question.OptionC
                                            </span>

                                        </label>

                                    </div>


                                    <div class="option-wrapper">

                                        <input type="radio"
                                               id="q@(question.QuestionID)_optionD"
                                               name="question_@question.QuestionID"
                                               value="D"
                                               class="option-input"
                                               required
                                               onchange="updateProgress()">

                                        <label for="q@(question.QuestionID)_optionD"
                                               class="option-label">

                                            <span class="option-letter">
                                                D
                                            </span>

                                            <span class="option-text">
                                                @question.OptionD
                                            </span>

                                        </label>

                                    </div>

                                </div>

                            </div>

                            questionNumber++;
                        }

                    </div>


                    <!-- Form Actions -->

                    <div class="quiz-actions">

                        <button type="submit"
                                class="btn btn-primary"
                                id="submitBtn">

                            <ion-icon name="checkmark-circle-outline"></ion-icon>

                            <span>Submit Quiz</span>

                        </button>


                        <a href="@Url.Action("ViewQuizzes", "StudentViewQuizzes")"
                           class="btn btn-secondary">

                            <ion-icon name="arrow-back-outline"></ion-icon>

                            <span>Cancel Quiz</span>

                        </a>

                    </div>

                }

            }
            else
            {

                <div class="alert alert-info">

                    <ion-icon name="information-circle-outline"></ion-icon>

                    <span>
                        No questions available for this quiz yet.
                    </span>

                </div>

            }

        </div>

    </main>


    <!-- Footer -->

    <footer class="footer">

        <div class="footer-content">

            <p>
                &copy; 2024 LearnLink. All rights reserved. Quiz Platform
            </p>

        </div>

    </footer>


    <script>

    // ==========================================
    // Progress Tracker
    // ==========================================

    function updateProgress() {

        var totalQuestions = @(Model?.Count ?? 0);

        var answeredQuestions =
            document.querySelectorAll(
                'input[name^="question_"]:checked'
            ).length;


        document.getElementById("currentQuestion")
            .textContent = answeredQuestions;


        var percentage = 0;

        if (totalQuestions > 0) {
            percentage =
                (answeredQuestions / totalQuestions) * 100;
        }


        document.getElementById("progressFill")
            .style.width = percentage + "%";
    }


    // ==========================================
    // Timer
    // ==========================================

    document.addEventListener("DOMContentLoaded", function () {

        var endTime =
            new Date(
                '@HttpContext.Current.Session["QuizEndtime"]'
            ).getTime();


        function updateTimer() {

            var now = new Date().getTime();

            var timeLeft = endTime - now;


            if (timeLeft <= 0) {

                document.getElementById("timerDisplay")
                    .textContent = "00:00";

                document.getElementById("timerStatus")
                    .textContent = "Time's Up!";

                document.getElementById("timerStatus")
                    .style.color = "#ef4444";


                var submitButton =
                    document.getElementById("submitBtn");


                if (submitButton) {
                    submitButton.click();
                }

                return;
            }


            var minutes =
                Math.floor(timeLeft / 60000);


            var seconds =
                Math.floor(
                    (timeLeft % 60000) / 1000
                );


            var displayText =
                (minutes < 10 ? "0" : "") +
                minutes +
                ":" +
                (seconds < 10 ? "0" : "") +
                seconds;


            document.getElementById("timerDisplay")
                .textContent = displayText;


            var timerBar =
                document.querySelector(".timer-bar");

            var timerStatus =
                document.getElementById("timerStatus");


            if (timeLeft <= 300000) {

                timerBar.classList.add("critical");

                timerStatus.textContent = "Critical!";
            }


            if (timeLeft <= 60000) {

                timerBar.classList.add("warning");
            }


            setTimeout(updateTimer, 1000);
        }


        updateTimer();

        updateProgress();

    });

    </script>

</body>
</html>
