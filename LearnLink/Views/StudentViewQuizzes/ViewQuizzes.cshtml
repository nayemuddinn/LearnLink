@model List<LearnLink.Models.Quiz>
@{
    ViewBag.Title = "Available Quizzes";
    Layout = null;
    var alertMessage = TempData["AlertMessage"] as string;
    string userRole = Session["UserRole"] != null ? Session["UserRole"].ToString() : "";
    string userName = Session["UserName"] != null ? Session["UserName"].ToString() : "Guest";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Available Quizzes - LearnLink</title>

    <link href="@Url.Content("~/Content/ViewQuizzes.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <script type="text/javascript">
            window.onload = function() {
                alert('@alertMessage');
                window.location.href = '@Url.Action("ViewQuizzes")'; 
            };
        </script>
    }


    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>
                <div class="logo-text-group">
                    <span class="logo-text">LearnLink</span>
                    <span class="role-badge">@userRole</span>
                </div>
            </div>

            <div class="navbar-menu">
                <div class="nav-links">
                    @{
                        if (userRole.Equals("Student"))
                        {
                            <a href="@Url.Action("AllCourse", "AllCourse")" class="nav-link">
                                <ion-icon name="book-outline"></ion-icon>
                                <span>All Courses</span>
                            </a>
                            <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")" class="nav-link">
                                <ion-icon name="school-outline"></ion-icon>
                                <span>Enrolled Courses</span>
                            </a>
                            <a href="@Url.Action("Assessment", "Assessment")" class="nav-link active">
                                <ion-icon name="checkmark-circle-outline"></ion-icon>
                                <span>Assessments</span>
                            </a>
                            <a href="@Url.Action("editStudentProfile", "editStudentProfile")" class="nav-link">
                                <ion-icon name="person-outline"></ion-icon>
                                <span>Edit Profile</span>
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("ManageCourse", "ManageCourse")" class="nav-link">
                                <ion-icon name="book-outline"></ion-icon>
                                <span>Manage Courses</span>
                            </a>
                            <a href="@Url.Action("createCourse", "createCourse")" class="nav-link">
                                <ion-icon name="add-circle-outline"></ion-icon>
                                <span>Create Courses</span>
                            </a>
                            <a href="@Url.Action("courseMaterials", "courseMaterials")" class="nav-link">
                                <ion-icon name="document-text-outline"></ion-icon>
                                <span>Course Materials</span>
                            </a>
                            <a href="@Url.Action("enrollStudents", "enrollStudents")" class="nav-link">
                                <ion-icon name="person-add-outline"></ion-icon>
                                <span>Enroll Students</span>
                            </a>
                            <a href="@Url.Action("Assessment", "Assessment")" class="nav-link active">
                                <ion-icon name="checkmark-circle-outline"></ion-icon>
                                <span>Assessments</span>
                            </a>
                            <a href="@Url.Action("editteacherProfile", "editteacherProfile")" class="nav-link">
                                <ion-icon name="person-outline"></ion-icon>
                                <span>Edit Profile</span>
                            </a>
                        }
                    }
                </div>
            </div>

            <div class="navbar-user">
                <div class="user-info">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <span class="user-name">@userName</span>
                </div>
                <a href="@Url.Action("login", "Login")" class="logout-btn" title="Log Out">
                    <ion-icon name="log-out-outline"></ion-icon>
                </a>
            </div>

            <div class="navbar-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="main-content">
        <div class="page-container">

            <div class="page-header-title">
                <h1>Available Quizzes</h1>
                <p>Take assessments and view your scores for enrolled courses.</p>
            </div>

            <div class="tiles-grid">
                @if (Model == null || Model.Count == 0)
                {
                    <div class="empty-state">
                        <ion-icon name="information-circle-outline"></ion-icon>
                        <h3>No Quizzes Available</h3>
                        <p>Enroll in courses or wait for your instructor to start a quiz.</p>
                    </div>
                }
                else
                {
                    foreach (var quiz in Model)
                    {
                        <div class="glass-card">
                            <div class="card-header">
                                <div class="card-icon-wrapper">
                                    <ion-icon name="document-text-outline"></ion-icon>
                                </div>
                                <div class="card-titles">
                                    <h3>@quiz.Title</h3>
                                    <span class="course-id-tag">@quiz.CourseName</span>
                                </div>
                            </div>

                            <div class="card-body">
                                <div class="quiz-details-grid" style="grid-template-columns: 1fr 1fr;">
                                    <div class="detail-item">
                                        <span class="detail-label">Duration</span>
                                        <span class="detail-value">@quiz.Duration min</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Created</span>
                                        <span class="detail-value">@quiz.CreationDate.ToString("MMM dd")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Student Actions (1 column layout) -->
                            <div class="card-actions" style="grid-template-columns: 1fr;">
                                @if (quiz.Score != -1)
                                {
                                    <div class="status-banner success-banner">
                                        <ion-icon name="checkmark-circle-outline"></ion-icon>
                                        <span>Completed - Score: @quiz.Score</span>
                                    </div>
                                }
                                else if (quiz.Status == "Started")
                                {
                                    <a href="@Url.Action("StartQuiz", "StudentViewQuizzes", new { id = quiz.QuizID })" class="btn-action btn-start">
                                        <ion-icon name="play-circle-outline"></ion-icon>
                                        <span>Start Quiz</span>
                                    </a>
                                }
                                else
                                {
                                    <div class="status-banner locked-banner">
                                        <ion-icon name="lock-closed-outline"></ion-icon>
                                        <span>Not Yet Available</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

  
            <div class="back-action">
                <button type="button" class="btn-back" onclick="window.location.href='@Url.Action("Assessment", "Assessment")'">
                    <ion-icon name="arrow-back-outline"></ion-icon>
                    <span>Back to Assessment</span>
                </button>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2026 LearnLink. All rights reserved.</p>
        </div>
    </footer>

    <script>
    
        document.querySelector('.navbar-toggle').addEventListener('click', function () {
            document.querySelector('.navbar-menu').classList.toggle('active');
        });
    </script>
</body>
</html>