@model List<LearnLink.Models.EnrolledStudentCourse>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Enrolled Students - LearnLink</title>
    <link href="@Url.Content("/Content/AllEnrolledStudents.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>
    <!-- Professional Top Navbar -->
    <nav class="navbar">
        <div class="navbar-container">
            <!-- Logo -->
            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>
                <span class="logo-text">LearnLink</span>
            </div>

            <!-- Navigation Links -->
            <div class="navbar-menu">
                <div class="nav-links">
                    <a href="@Url.Action("ManageCourse", "ManageCourse")" class="nav-link">
                        <ion-icon name="book-outline"></ion-icon>
                        <span>Manage</span>
                    </a>
                    <a href="@Url.Action("createCourse", "createCourse")" class="nav-link">
                        <ion-icon name="add-circle-outline"></ion-icon>
                        <span>Create</span>
                    </a>
                    <a href="@Url.Action("courseMaterials", "courseMaterials")" class="nav-link">
                        <ion-icon name="document-outline"></ion-icon>
                        <span>Materials</span>
                    </a>
                    <a href="@Url.Action("enrollStudents", "enrollStudents")" class="nav-link active">
                        <ion-icon name="people-outline"></ion-icon>
                        <span>Enroll</span>
                    </a>
                </div>
            </div>

            <!-- User Profile & Logout -->
            <div class="navbar-user">
                <div class="user-info">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <div class="user-details">
                        <p class="user-name">@HttpContext.Current.Session["UserName"]</p>
                        <p class="user-role">@HttpContext.Current.Session["UserRole"]</p>
                    </div>
                </div>
                <a href="@Url.Action("login", "Login")" class="logout-btn" title="Log Out">
                    <ion-icon name="log-out-outline"></ion-icon>
                </a>
            </div>

            <!-- Mobile Menu Toggle -->
            <div class="navbar-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="main-content">
        <div class="page-container">
            <!-- Page Header -->
            <div class="page-header">
                <div class="header-content">
                    <div class="header-text">
                        <h1>Enrolled Students</h1>
                        <p>Manage all students enrolled across your courses. View details and manage enrollments.</p>
                    </div>
                    <div class="header-illustration">
                        <div class="illustration-box">
                            <ion-icon name="people-outline"></ion-icon>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Students Count Card -->
            <div class="stats-card">
                <div class="stat-item">
                    <div class="stat-icon">
                        <ion-icon name="people-outline"></ion-icon>
                    </div>
                    <div class="stat-content">
                        <p class="stat-label">Total Enrollments</p>
                        <h3 class="stat-value">@Model.Count</h3>
                    </div>
                </div>
            </div>

            <!-- Search Form Section -->
            <div class="search-section">
                <form method="get" action="@Url.Action("AllEnrolledStudents", "enrollStudents")" class="search-form">
                    <div class="search-input-group">
                        <ion-icon name="search-outline" class="search-icon"></ion-icon>
                        <input type="text" name="searchTerm" placeholder="Search by ID, name, institution, or phone..." value..." value="@ViewBag.SearchTerm" class="search-input" autocomplete="off" />
                        <button type="submit" class="search-btn">
                            <ion-icon name="search-outline"></ion-icon>
                            <span>Search</span>
                        </button>
                    </div>
                </form>
            </div>


                <!-- Students Table Section -->
                <div class="table-section">
                    @if (Model != null && Model.Count > 0)
                    {
                        <div class="table-wrapper">
                            <table class="students-table">
                                <thead>
                                    <tr>
                                        <th class="col-course">
                                            <ion-icon name="book-outline"></ion-icon>
                                            <span>Course</span>
                                        </th>
                                        <th class="col-student">
                                            <ion-icon name="person-outline"></ion-icon>
                                            <span>Student Name</span>
                                        </th>
                                        <th class="col-institution">
                                            <ion-icon name="school-outline"></ion-icon>
                                            <span>Institution</span>
                                        </th>
                                        <th class="col-phone">
                                            <ion-icon name="call-outline"></ion-icon>
                                            <span>Phone</span>
                                        </th>
                                        <th class="col-actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="table-row" data-course="@item.CourseName" data-student="@item.StudentName">
                                            <td class="col-course">
                                                <div class="course-info">
                                                    <div class="course-badge">@item.CourseID</div>
                                                    <div class="course-details">
                                                        <p class="course-name">@item.CourseName</p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="col-student">
                                                <div class="student-info">
                                                    <ion-icon name="person-circle" class="student-avatar"></ion-icon>
                                                    <p class="student-name">@item.StudentName</p>
                                                </div>
                                            </td>
                                            <td class="col-institution">
                                                <span class="institution-text">@(string.IsNullOrEmpty(item.Institution) ? "-" : item.Institution)</span>
                                            </td>
                                            <td class="col-phone">
                                                <span class="phone-text">@(string.IsNullOrEmpty(item.Phone) ? "-" : item.Phone)</span>
                                            </td>
                                            <td class="col-actions">
                                                <a href="@Url.Action("UnenrollStudent", "enrollStudents", new { studentId = item.StudentID, courseId = item.CourseID, page=1})" class="btn btn-unenroll" title="Unenroll Student">
                                                    <ion-icon name="trash-outline"></ion-icon>
                                                    <span>Unenroll</span>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-icon">
                                <ion-icon name="people-outline"></ion-icon>
                            </div>
                            <h2>No Enrolled Students</h2>
                            <p>There are currently no students enrolled in your courses. Enrollments will appear here once students sign up.</p>
                            <a href="@Url.Action("enrollStudents", "enrollStudents")" class="btn btn-primary">
                                <ion-icon name="add-circle-outline"></ion-icon>
                                <span>Start Enrolling Students</span>
                            </a>
                        </div>
                    }

                    <!-- Page Actions -->
                    <div class="page-actions">
                        <a href="@Url.Action("enrollStudents", "enrollStudents")" class="btn btn-secondary">
                            <ion-icon name="arrow-back-outline"></ion-icon>
                            <span>Back to Enrollment</span>
                        </a>
                    </div>
                </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2024 LearnLink. All rights reserved. Student Management System</p>
        </div>
    </footer>

    <script>
        // Mobile menu toggle
        document.querySelector('.navbar-toggle').addEventListener('click', function() {
            document.querySelector('.navbar-menu').classList.toggle('active');
        });

        // Close mobile menu when clicking on a link
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', function() {
                document.querySelector('.navbar-menu').classList.remove('active');
            });
        });

        // Add row hover effect
        document.querySelectorAll('.table-row').forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.transform = 'scale(1.01)';
            });
            row.addEventListener('mouseleave', function() {
                this.style.transform = 'scale(1)';
            });
        });
    </script>
</body>
</html>
