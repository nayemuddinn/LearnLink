@model List<LearnLink.Models.Enrollment>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enroll Students - LearnLink</title>
    <link href="@Url.Content("~/Content/enrollnewstudent.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>
    <!-- Top Navigation Bar -->
    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>
                <div class="logo-text-group">
                    <span class="logo-text">LearnLink</span>
                    <span class="role-badge">@HttpContext.Current.Session["UserRole"]</span>
                </div>
            </div>

            <div class="navbar-menu">
                <div class="nav-links">
                    @{
                        if (Session["UserRole"] != null && Session["UserRole"].Equals("Student"))
                        {
                            <a href="@Url.Action("Dashboard", "StudentDashboard")" class="nav-link">
                                <ion-icon name="book-outline"></ion-icon>
                                <span>Dashboard</span>
                            </a>

                            <a href="@Url.Action("AllCourse", "AllCourse")" class="nav-link">
                                <ion-icon name="book-outline"></ion-icon>
                                <span>All Courses</span>
                            </a>
                            <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")" class="nav-link">
                                <ion-icon name="school-outline"></ion-icon>
                                <span>Enrolled Courses</span>
                            </a>
                            <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                                <ion-icon name="checkmark-circle-outline"></ion-icon>
                                <span>Assessments</span>
                            </a>
                            <a href="@Url.Action("editStudentProfile", "editStudentProfile")" class="nav-link">
                                <ion-icon name="person-outline"></ion-icon>
                                <span> Profile</span>
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Dashboard", "TeacherDashboard")" class="nav-link">
                                <ion-icon name="book-outline"></ion-icon>
                                <span>Dashboard</span>
                            </a>

                            <a href="@Url.Action("ManageCourse", "ManageCourse")" class="nav-link">
                                <ion-icon name="book-outline"></ion-icon>
                                <span>Manage Courses</span>
                            </a>
                            <a href="@Url.Action("createCourse", "createCourse")" class="nav-link">
                                <ion-icon name="add-circle-outline"></ion-icon>
                                <span>Create Courses</span>
                            </a>
                            <a href="@Url.Action("courseMaterials", "courseMaterials")" class="nav-link">
                                <ion-icon name="document-text-outline"></ion-icon>
                                <span>Upload Materials</span>
                            </a>
                            <a href="@Url.Action("enrollStudents", "enrollStudents")" class="nav-link active">
                                <ion-icon name="person-add-outline"></ion-icon>
                                <span>Enroll Students</span>
                            </a>
                            <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                                <ion-icon name="checkmark-circle-outline"></ion-icon>
                                <span>Assessments</span>
                            </a>
                            <a href="@Url.Action("editteacherProfile", "editteacherProfile")" class="nav-link">
                                <ion-icon name="person-outline"></ion-icon>
                                <span> Profile</span>
                            </a>
                        }
                    }
                </div>
            </div>

            <div class="navbar-user">
                <div class="user-info">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <span class="user-name">@HttpContext.Current.Session["UserName"]</span>
                </div>
                <a href="@Url.Action("Logout", "Logout")" class="logout-btn" title="Log Out">
                    <ion-icon name="log-out-outline"></ion-icon>
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="main-content">
        <div class="page-container">

            <!-- Header Banner -->
            <div class="page-header">
                <div class="header-content">
                    <div class="header-text">
                        <h1>Enroll New Students</h1>
                        <p>Manage and review pending student course enrollment requests.</p>
                    </div>
                    <div class="illustration-box">
                        <ion-icon name="person-add-outline"></ion-icon>
                    </div>
                </div>
            </div>

            <!-- Table Card -->
            <div class="table-header">
                <h2>Enrollment Requests</h2>
            </div>

            <div class="search-section">

                <form method="get"
                      action="@Url.Action("enrollNewStudents", "enrollStudents")"
                      class="search-form">

                    <div class="search-controls">

                        <div class="search-input-group">

                            <ion-icon name="search-outline"
                                      class="search-icon">
                            </ion-icon>

                            <input type="text"
                                   name="searchTerm"
                                   placeholder="Search by  course, student, or institution..."
                                   value="@ViewBag.SearchTerm"
                                   class="search-input"
                                   autocomplete="off" />

                            <button type="submit"
                                    class="search-btn">

                                <ion-icon name="search-outline"></ion-icon>
                                <span>Search</span>

                            </button>

                        </div>

                        <div class="filter-group">
                            <label for="pageSize">Show</label>

                            <select id="pageSize"
                                    name="pageSize"
                                    class="filter-select"
                                    onchange="this.form.submit()">

                                <option value="10"
                                        @(ViewBag.PageSize == 10 ? "selected" : "")>
                                    10
                                </option>

                                <option value="100"
                                        @(ViewBag.PageSize == 100 ? "selected" : "")>
                                    100
                                </option>

                                <option value="1000"
                                        @(ViewBag.PageSize == 1000 ? "selected" : "")>
                                    1000
                                </option>

                            </select>
                        </div>

                        <div class="filter-group">
                            <label for="sortBy">Sort By</label>

                            <select id="sortBy"
                                    name="sortBy"
                                    class="filter-select"
                                    onchange="this.form.submit()">

                     

                                <option value="CourseID"
                                        @(ViewBag.SortBy == "CourseID" ? "selected" : "")>
                                    Course ID
                                </option>

                                <option value="CourseName"
                                        @(ViewBag.SortBy == "CourseName" ? "selected" : "")>
                                    Course Name
                                </option>

                                <option value="StudentID"
                                        @(ViewBag.SortBy == "StudentID" ? "selected" : "")>
                                    Student ID
                                </option>

                                <option value="StudentName"
                                        @(ViewBag.SortBy == "StudentName" ? "selected" : "")>
                                    Student Name
                                </option>

                                <option value="StudentInstitution"
                                        @(ViewBag.SortBy == "StudentInstitution" ? "selected" : "")>
                                    Institution
                                </option>

                            </select>
                        </div>

                        <div class="filter-group">
                            <label for="sortOrder">Order</label>

                            <select id="sortOrder"
                                    name="sortOrder"
                                    class="filter-select"
                                    onchange="this.form.submit()">

                                <option value="ASC"
                                        @(ViewBag.SortOrder == "ASC" ? "selected" : "")>
                                    Ascending
                                </option>

                                <option value="DESC"
                                        @(ViewBag.SortOrder == "DESC" ? "selected" : "")>
                                    Descending
                                </option>

                            </select>
                        </div>

                    </div>

                </form>

            </div>

            <div class="table-body">
                @if (Model != null && Model.Count > 0)
                {
                    <table class="requests-table">
                        <thead>
                            <tr>
                                <th>Enrollment ID</th>
                                <th>Course ID</th>
                                <th>Course Name</th>
                                <th>Student ID</th>
                                <th>Student Name</th>
                                <th>Student Institution</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td data-label="Enrollment ID">
                                        <span class="badge-id">#@request.EnrollmentID</span>
                                    </td>
                                    <td data-label="Course ID">#@request.CourseID</td>
                                    <td data-label="Course Name">
                                        <strong>@request.CourseName</strong>
                                    </td>
                                    <td data-label="Student ID">#@request.StudentID</td>
                                    <td data-label="Student Name">@request.StudentName</td>
                                    <td data-label="Student Institution">
                                        <div class="institution-cell">
                                            <ion-icon name="business-outline"></ion-icon>
                                            <span>@request.StudentInstitution</span>
                                        </div>
                                    </td>
                                    <td data-label="Action">
                                        <div class="action-buttons">
                                            <a href="@Url.Action("UpdateRequest", "enrollStudents", new { enrollmentID = request.EnrollmentID, actionType = "accept" })" class="btn-action btn-accept">
                                                <ion-icon name="checkmark-outline"></ion-icon>
                                                <span>Accept</span>
                                            </a>
                                            <a href="@Url.Action("UpdateRequest", "enrollStudents", new { enrollmentID = request.EnrollmentID, actionType = "reject" })" class="btn-action btn-reject">
                                                <ion-icon name="close-outline"></ion-icon>
                                                <span>Reject</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <ion-icon name="checkmark-done-circle-outline" class="empty-icon"></ion-icon>
                        <h3>No pending requests</h3>
                        <p>All student enrollment requests have been processed.</p>
                    </div>
                }
            </div>
        </div>

            <!-- Back Action Button -->
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="window.location.href='/enrollStudents/enrollStudents'">
                    <ion-icon name="arrow-back-outline"></ion-icon>
                    <span>Back</span>
                </button>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2026 LearnLink. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>