@model List<LearnLink.Models.Course>

@{
    ViewBag.Title = "Manage Courses";
    Layout = null;
    string userRole = Session["UserRole"] != null ? Session["UserRole"].ToString() : "";
    string userName = Session["UserName"] != null ? Session["UserName"].ToString() : "Guest";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Courses - LearnLink</title>
    <link href="@Url.Content("~/Content/ManageCourse.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar">
        <div class="navbar-container">

            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>
                <div class="logo-text-group">
                    <span class="logo-text">LearnLink</span>
                    <span class="role-badge">@userRole</span>
                </div>
            </div>

            <div class="navbar-menu">
                <div class="nav-links">
                    @if (userRole.Equals("Student"))
                    {
                        <a href="@Url.Action("AllCourse", "AllCourse")" class="nav-link">
                            <ion-icon name="book-outline"></ion-icon>
                            <span>All Courses</span>
                        </a>
                        <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")" class="nav-link">
                            <ion-icon name="school-outline"></ion-icon>
                            <span>Enrolled Courses</span>
                        </a>
                        <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            <span>Assessments</span>
                        </a>
                        <a href="@Url.Action("editStudentProfile", "editStudentProfile")" class="nav-link">
                            <ion-icon name="person-outline"></ion-icon>
                            <span> Profile</span>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("ManageCourse", "ManageCourse")" class="nav-link active">
                            <ion-icon name="book-outline"></ion-icon>
                            <span>Manage Courses</span>
                        </a>
                        <a href="@Url.Action("createCourse", "createCourse")" class="nav-link">
                            <ion-icon name="add-circle-outline"></ion-icon>
                            <span>Create Courses</span>
                        </a>
                        <a href="@Url.Action("courseMaterials", "courseMaterials")" class="nav-link">
                            <ion-icon name="document-text-outline"></ion-icon>
                            <span>Upload Materials</span>
                        </a>
                        <a href="@Url.Action("enrollStudents", "enrollStudents")" class="nav-link">
                            <ion-icon name="person-add-outline"></ion-icon>
                            <span>Enroll Students</span>
                        </a>
                        <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            <span>Assessments</span>
                        </a>
                        <a href="@Url.Action("editteacherProfile", "editteacherProfile")" class="nav-link">
                            <ion-icon name="person-outline"></ion-icon>
                            <span> Profile</span>
                        </a>
                    }
                </div>
            </div>

            <div class="navbar-user">
                <div class="user-info">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <span class="user-name">@userName</span>
                </div>
                <a href="@Url.Action("Logout", "Logout")" class="logout-btn" title="Log Out">
                    <ion-icon name="log-out-outline"></ion-icon>
                </a>
            </div>

            <div class="navbar-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>

        </div>
    </nav>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main-content">
        <div class="page-container">

            <div class="page-header-title">
                <h1>Manage Your Courses</h1>
                <p>View course materials or set up quizzes for your enrolled students.</p>
            </div>

            <div class="tiles-grid">
                @if (Model != null && Model.Any())
                {
                    foreach (var course in Model)
                    {
                        <div class="glass-card">
                            <div class="card-header">
                                <div class="card-icon-wrapper">
                                    <ion-icon name="book-outline"></ion-icon>
                                </div>
                                <div class="card-titles">
                                    <h3>@course.CourseName</h3>
                                    <span class="course-id-tag">ID: #@course.CourseID</span>
                                </div>
                            </div>

                            <div class="card-body">
                                <div class="meta-item description-item">
                                    <ion-icon name="information-circle-outline"></ion-icon>
                                    <span>@course.CourseDescription</span>
                                </div>
                                <div class="meta-item">
                                    <ion-icon name="calendar-outline"></ion-icon>
                                    <span>Created: @course.CourseCreateDate</span>
                                </div>
                            </div>

                            <div class="card-actions">
                                <a href="@Url.Action("ShowCourseMaterials", "ManageCourse", new { courseid = course.CourseID })" class="btn-action btn-view">
                                    <ion-icon name="folder-open-outline"></ion-icon>
                                    <span>View Materials</span>
                                </a>
                                <a href="@Url.Action("ShowCourseMaterials", "ManageCourse", new { courseid = course.CourseID })" class="btn-action btn-view">
                                    <ion-icon name="cloud-upload-outline"></ion-icon>
                                    <span>Upload</span>
                                </a>
                                <a href="@Url.Action("CreateQuiz", "CreateQuiz", new { courseID = course.CourseID })" class="btn-action btn-quiz">
                                    <ion-icon name="create-outline"></ion-icon>
                                    <span>Create Quiz</span>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <ion-icon name="folder-open-outline"></ion-icon>
                        <h3>No Courses Available</h3>
                        <p>You haven't created any courses yet.</p>
                    </div>
                }
            </div>

        </div>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2024 LearnLink. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Mobile menu toggle
        document.querySelector('.navbar-toggle').addEventListener('click', function () {
            document.querySelector('.navbar-menu').classList.toggle('active');
        });
    </script>

</body>
</html>
