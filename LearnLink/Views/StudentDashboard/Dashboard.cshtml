@model LearnLink.Models.User

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - LearnLink</title>
    <link href="@Url.Content("/Content/dashboard.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <div class="logo-icon">
                    <ion-icon name="school-outline"></ion-icon>
                </div>
                <div class="logo-text">
                    <h2>LearnLink</h2>
                    <p>@HttpContext.Current.Session["UserRole"]</p>
                </div>
            </div>
        </div>

        <nav class="sidebar-nav">
            @{
                if (Session["UserRole"].Equals("Student"))
                {
                    <a href="@Url.Action("AllCourse", "AllCourse")" class="nav-link">
                        <ion-icon name="book-outline"></ion-icon>
                        <span>All Courses</span>
                    </a>
                    <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")" class="nav-link">
                        <ion-icon name="school-outline"></ion-icon>
                        <span>Enrolled Courses</span>
                    </a>
                    <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                        <ion-icon name="checkmark-circle-outline"></ion-icon>
                        <span>Assessments</span>
                    </a>
                    <a href="@Url.Action("editStudentProfile", "editStudentProfile")" class="nav-link">
                        <ion-icon name="person-outline"></ion-icon>
                        <span>Edit Profile</span>
                    </a>
                    <hr class="sidebar-divider">
                    <a href="@Url.Action("login", "Login")" class="nav-link nav-logout">
                        <ion-icon name="log-out-outline"></ion-icon>
                        <span>Log Out</span>
                    </a>
                }
                else
                {
                    <a href="@Url.Action("ManageCourse", "ManageCourse")" class="nav-link">
                        <ion-icon name="book-outline"></ion-icon>
                        <span>Manage Courses</span>
                    </a>
                    <a href="@Url.Action("createCourse", "createCourse")" class="nav-link">
                        <ion-icon name="add-circle-outline"></ion-icon>
                        <span>Create Courses</span>
                    </a>
                    <a href="@Url.Action("courseMaterials", "courseMaterials")" class="nav-link">
                        <ion-icon name="document-outline"></ion-icon>
                        <span>Course Materials</span>
                    </a>
                    <a href="@Url.Action("enrollStudents", "enrollStudents")" class="nav-link">
                        <ion-icon name="people-outline"></ion-icon>
                        <span>Enroll Students</span>
                    </a>
                    <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                        <ion-icon name="checkmark-circle-outline"></ion-icon>
                        <span>Assessments</span>
                    </a>
                    <a href="@Url.Action("editteacherProfile", "editteacherProfile")" class="nav-link">
                        <ion-icon name="person-outline"></ion-icon>
                        <span>Edit Profile</span>
                    </a>
                    <hr class="sidebar-divider">
                    <a href="@Url.Action("login", "Login")" class="nav-link nav-logout">
                        <ion-icon name="log-out-outline"></ion-icon>
                        <span>Log Out</span>
                    </a>
                }
            }
        </nav>
    </aside>

    <!-- Main Content Area -->
    <div class="main-container">
        <!-- Top Header -->
        <header class="top-header">
            <div class="header-left">
                <h1>Dashboard</h1>
            </div>
            <div class="header-right">
                <div class="user-profile">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <span class="user-name">@HttpContext.Current.Session["UserName"]</span>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="main-content">
            @{
                if (Session["UserRole"].Equals("Student"))
                {
                    <section class="content-section">
                        <div class="section-header">
                            <h2>Quick Access</h2>
                            <p>Your learning dashboard</p>
                        </div>
                        <div class="tiles-grid">
                                                        <div class="tiles-grid">
                                                            <div class="card">
                                                                <div class="card-icon">
                                                                    <ion-icon name="book-outline"></ion-icon>
                                                                </div>
                                                                <div class="card-body">
                                                                    <h3>My Courses</h3>
                                                                    <p>Overview and actions</p>
                                                                </div>
                                                                <a href="@Url.Action("AllCourse", "AllCourse")" class="card-action">
                                                                    <span>Go to Courses</span>
                                                                    <ion-icon name="arrow-forward-outline"></ion-icon>
                                                                </a>
                                                            </div>

                                                            <div class="card">
                                                                <div class="card-icon">
                                                                    <ion-icon name="school-outline"></ion-icon>
                                                                </div>
                                                                <div class="card-body">
                                                                    <h3>Enrolled Courses</h3>
                                                                    <p>See Enrolled courses</p>
                                                                </div>
                                                                <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")" class="card-action">
                                                                    <span>See Your Courses</span>
                                                                    <ion-icon name="arrow-forward-outline"></ion-icon>
                                                                </a>
                                                            </div>

                                                            <div class="card">
                                                                <div class="card-icon">
                                                                    <ion-icon name="checkmark-circle-outline"></ion-icon>
                                                                </div>
                                                                <div class="card-body">
                                                                    <h3>Assessments</h3>
                                                                    <p>Take Assessments</p>
                                                                </div>
                                                                <a href="@Url.Action("Assessment", "Assessment")" class="card-action">
                                                                    <span>Assess Yourself</span>
                                                                    <ion-icon name="arrow-forward-outline"></ion-icon>
                                                                </a>
                                                            </div>

                                                            <div class="card">
                                                                <div class="card-icon">
                                                                    <ion-icon name="person-outline"></ion-icon>
                                                                </div>
                                                                <div class="card-body">
                                                                    <h3>Edit Profile</h3>
                                                                    <p>Update your information</p>
                                                                </div>
                                                                <a href="@Url.Action("editStudentProfile", "editStudentProfile")" class="card-action">
                                                                    <span>Edit Now</span>
                                                                    <ion-icon name="arrow-forward-outline"></ion-icon>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </section>
                                                }
                                                else
                                                {
                                                    <section class="content-section">
                                                        <div class="section-header">
                                                            <h2>Course Management</h2>
                                                            <p>Manage and create your courses</p>
                                                        </div>
                                                        <div class="tiles-grid">
                                                            <div class="card">
                                                                <div class="card-icon">
                                                                    <ion-icon name="book-outline"></ion-icon>
                                                                </div>
                                                                <div class="card-body">
                                                                    <h3>Manage Courses</h3>
                                                                    <p>Overview and actions</p>
                                                                </div>
                                                                <a href="@Url.Action("ManageCourse", "ManageCourse")" class="card-action">
                                                                    <span>Go to Courses</span>
                                                                    <ion-icon name="arrow-forward-outline"></ion-icon>
                                                                </a>
                                                            </div>

                                                            <div class="card">
                                                                <div class="card-icon">
                                                                    <ion-icon name="add-circle-outline"></ion-icon>
                                                                </div>
                                                                <div class="card-body">
                                                                    <h3>Create Courses</h3>
                                                                    <p>Start a new course</p>
                                                                </div>
                                                                <a href="@Url.Action("createCourse", "createCourse")" class="card-action">
                                                                    <span>Create Now</span>
                                                                    <ion-icon name="arrow-forward-outline"></ion-icon>
                                                                </a>
                                                            </div>

                                                            <div class="card">
                                                                <div class="card-icon">
                                                                    <ion-icon name="document-outline"></ion-icon>
                                                                </div>
                                                                <div class="card-body">
                                                                    <h3>Course Materials</h3>
                                                                    <p>Upload Your Materials</p>
                                                                </div>
                                                                <a href="@Url.Action("courseMaterials", "courseMaterials")" class="card-action">
                                                                    <span>Upload Now</span>
                                                                    <ion-icon name="arrow-forward-outline"></ion-icon>
                                                                </a>
                                                            </div>

                                                            <div class="card">
                                                                <div class="card-icon">
                                                                    <ion-icon name="people-outline"></ion-icon>
                                                                </div>
                                                                <div class="card-body">
                                                                    <h3>Enroll Students</h3>
                                                                    <p>Add students to courses</p>
                                                                </div>
                                                                <a href="@Url.Action("enrollStudents", "enrollStudents")" class="card-action">
                                                                    <span>Enroll Now</span>
                                                                    <ion-icon name="arrow-forward-outline"></ion-icon>
                                                                </a>
                                                            </div>

                                                            <div class="card">
                                                                <div class="card-icon">
                                                                    <ion-icon name="checkmark-circle-outline"></ion-icon>
                                                                </div>
                                                                <div class="card-body">
                                                                    <h3>Review Assessments</h3>
                                                                    <p>Assess and grade</p>
                                                                </div>
                                                                <a href="@Url.Action("Assessment", "Assessment")" class="card-action">
                                                                    <span>Review Now</span>
                                                                    <ion-icon name="arrow-forward-outline"></ion-icon>
                                                                </a>
                                                            </div>

                                                            <div class="card">
                                                                <div class="card-icon">
                                                                    <ion-icon name="person-outline"></ion-icon>
                                                                </div>
                                                                <div class="card-body">
                                                                    <h3>Edit Profile</h3>
                                                                    <p>Update your information</p>
                                                                </div>
                                                                <a href="@Url.Action("editteacherProfile", "editteacherProfile")" class="card-action">
                                                                    <span>Edit Now</span>
                                                                    <ion-icon name="arrow-forward-outline"></ion-icon>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </section>
                                                }
                                            }
                                        </main>

                                        <!-- Footer -->
                                        <footer class="main-footer">
                                            <div class="footer-content">
                                                <p>&copy; 2024 LearnLink. All rights reserved.</p>
                                            </div>
                                        </footer>
                                    </div>
                                </body>
                                </html>
