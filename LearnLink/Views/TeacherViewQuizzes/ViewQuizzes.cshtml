@model List<LearnLink.Models.Quiz>
@{
    ViewBag.Title = "View Quizzes";
    Layout = null;
    var alertMessage = TempData["AlertMessage"] as string;
    string userRole = Session["UserRole"] != null ? Session["UserRole"].ToString() : "";
    string userName = Session["UserName"] != null ? Session["UserName"].ToString() : "Guest";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Quizzes - LearnLink</title>

    <link href="@Url.Content("~/Content/ViewQuizzes.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>

<body>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <script type="text/javascript">
            window.onload = function () {
                alert('@alertMessage');
                window.location.href = '@Url.Action("ViewQuizzes")';
            };
        </script>
    }

    <nav class="navbar">
        <div class="navbar-container">

            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>

                <div class="logo-text-group">
                    <span class="logo-text">LearnLink</span>
                    <span class="role-badge">@userRole</span>
                </div>
            </div>

            <div class="navbar-menu">
                <div class="nav-links">

                    @{
                        if (userRole.Equals("Student"))
                        {
                            <a href="@Url.Action("AllCourse", "AllCourse")" class="nav-link">
                                <ion-icon name="book-outline"></ion-icon>
                                <span>All Courses</span>
                            </a>

                            <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")" class="nav-link">
                                <ion-icon name="school-outline"></ion-icon>
                                <span>Enrolled Courses</span>
                            </a>

                            <a href="@Url.Action("Assessment", "Assessment")" class="nav-link active">
                                <ion-icon name="checkmark-circle-outline"></ion-icon>
                                <span>Assessments</span>
                            </a>

                            <a href="@Url.Action("editStudentProfile", "editStudentProfile")" class="nav-link">
                                <ion-icon name="person-outline"></ion-icon>
                                <span>Edit Profile</span>
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("ManageCourse", "ManageCourse")" class="nav-link">
                                <ion-icon name="book-outline"></ion-icon>
                                <span>Manage Courses</span>
                            </a>

                            <a href="@Url.Action("createCourse", "createCourse")" class="nav-link">
                                <ion-icon name="add-circle-outline"></ion-icon>
                                <span>Create Courses</span>
                            </a>

                            <a href="@Url.Action("courseMaterials", "courseMaterials")" class="nav-link">
                                <ion-icon name="document-text-outline"></ion-icon>
                                <span>Course Materials</span>
                            </a>

                            <a href="@Url.Action("enrollStudents", "enrollStudents")" class="nav-link">
                                <ion-icon name="person-add-outline"></ion-icon>
                                <span>Enroll Students</span>
                            </a>

                            <a href="@Url.Action("Assessment", "Assessment")" class="nav-link active">
                                <ion-icon name="checkmark-circle-outline"></ion-icon>
                                <span>Assessments</span>
                            </a>

                            <a href="@Url.Action("editteacherProfile", "editteacherProfile")" class="nav-link">
                                <ion-icon name="person-outline"></ion-icon>
                                <span>Edit Profile</span>
                            </a>
                        }
                    }

                </div>
            </div>

            <div class="navbar-user">

                <div class="user-info">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <span class="user-name">@userName</span>
                </div>

                <a href="@Url.Action("login", "Login")"
                   class="logout-btn"
                   title="Log Out">
                    <ion-icon name="log-out-outline"></ion-icon>
                </a>

            </div>

            <div class="navbar-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>

        </div>
    </nav>

    <main class="main-content">

        <div class="page-container">

            <div class="page-header-title">
                <h1>Your Quizzes</h1>
                <p>Manage, track, and review assessments for your courses.</p>
            </div>

            <div class="search-section">

                <form method="get"
                      action="@Url.Action("ViewQuizzes", "TeacherViewQuizzes")"
                      class="search-form">

                    <div class="search-input-group">

                        <ion-icon name="search-outline"
                                  class="search-icon"></ion-icon>

                        <input type="text"
                               name="searchTerm"
                               value="@ViewBag.SearchTerm"
                               placeholder="Search by course ID, course name, quiz title, or creation date..."
                               class="search-input"
                               autocomplete="off" />

                        <select name="filter"
                                class="search-select">

                            <option value="all"
                                    @(ViewBag.Filter == "all" ? "selected" : "")>
                                All Quizzes
                            </option>

                            <option value="notstarted"
                                    @(ViewBag.Filter == "notstarted" ? "selected" : "")>
                                Not Started
                            </option>

                            <option value="started"
                                    @(ViewBag.Filter == "started" ? "selected" : "")>
                                Started
                            </option>

                        </select>

                        <select name="sort"
                                class="search-select">

                            <option value="newest"
                                    @(ViewBag.Sort == "newest" ? "selected" : "")>
                                Newest First
                            </option>

                            <option value="oldest"
                                    @(ViewBag.Sort == "oldest" ? "selected" : "")>
                                Oldest First
                            </option>

                            <option value="name_asc"
                                    @(ViewBag.Sort == "name_asc" ? "selected" : "")>
                                Course Name A-Z
                            </option>

                            <option value="name_desc"
                                    @(ViewBag.Sort == "name_desc" ? "selected" : "")>
                                Course Name Z-A
                            </option>

                            <option value="courseid_asc"
                                    @(ViewBag.Sort == "courseid_asc" ? "selected" : "")>
                                Course ID Low-High
                            </option>

                            <option value="courseid_desc"
                                    @(ViewBag.Sort == "courseid_desc" ? "selected" : "")>
                                Course ID High-Low
                            </option>

                        </select>

                        <button type="submit" class="search-btn">
                            <ion-icon name="search-outline"></ion-icon>
                            <span>Search</span>
                        </button>

                    </div>

                </form>

            </div>

            <div class="tiles-grid">

                @if (Model == null || Model.Count == 0)
                {
                    <div class="empty-state">

                        <ion-icon name="document-text-outline"></ion-icon>

                        <h3>No Quizzes Found</h3>

                        <p>
                            @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm))
                            {
                                <span>No quizzes match your search.</span>
                            }
                            else
                            {
                                <span>Go to Create Quiz to get started and evaluate your students.</span>
                            }
                        </p>

                    </div>
                }
                else
                {
                    foreach (var quiz in Model)
                    {
                        <div class="glass-card">

                            <div class="card-header">

                                <div class="card-icon-wrapper">
                                    <ion-icon name="help-circle-outline"></ion-icon>
                                </div>

                                <div class="card-titles">
                                    <div class="quiz-info-row">
                                        <span class="quiz-id">Quiz ID: @quiz.QuizID</span>
                                        <span class="quiz-title">@quiz.Title</span>
                                        <span class="course-name">Course Name: @quiz.CourseName</span>
                                    </div>
                                </div>

                            </div>

                            <div class="card-body">

                                <div class="quiz-details-grid">

                                    <div class="detail-item">
                                        <span class="detail-label">Course</span>
                                        <span class="detail-value">@quiz.CourseName</span>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label">Duration</span>
                                        <span class="detail-value">@quiz.Duration min</span>
                                    </div>

                                    <div class="detail-item">

                                        <span class="detail-label">Status</span>

                                        <span class="detail-value status-badge @(quiz.Status == "NotStarted" ? "status-pending" : "status-active")">
                                            @quiz.Status
                                        </span>

                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label">Created</span>
                                        <span class="detail-value">
                                            @quiz.CreationDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </div>

                                </div>

                            </div>

                            <div class="card-actions">

                                @if (quiz.Status == "NotStarted")
                                {
                                    <a href="@Url.Action("StartQuiz", "TeacherViewQuizzes", new { id = quiz.QuizID })"
                                       class="btn-action btn-start">

                                        <ion-icon name="play-circle-outline"></ion-icon>
                                        <span>Start</span>

                                    </a>

                                    <a href="@Url.Action("UploadQuiz", "CreateQuiz", new { id = quiz.QuizID })"
                                       class="btn-action btn-upload">

                                        <ion-icon name="cloud-upload-outline"></ion-icon>
                                        <span>Upload</span>

                                    </a>
                                }

                            <a href="@Url.Action("Index", "QuizAnalytics", new { id = quiz.QuizID })"
                               class="btn-action btn-view">
                                <ion-icon name="analytics-outline"></ion-icon>
                                <span>Analytics</span>
                            </a>

                                <a href="@Url.Action("DeleteQuiz", "TeacherViewQuizzes", new { id = quiz.QuizID })"
                                   class="btn-action btn-danger"
                                   onclick="return confirm('Are you sure you want to delete this quiz?');">

                                    <ion-icon name="trash-outline"></ion-icon>
                                    <span>Delete</span>

                                </a>

                            </div>

                        </div>
                    }
                }

            </div>

            <div class="back-action">

                <button type="button"
                        class="btn-back"
                        onclick="window.location.href='@Url.Action("Assessment", "Assessment")'">

                    <ion-icon name="arrow-back-outline"></ion-icon>
                    <span>Back to Assessment</span>

                </button>

            </div>

        </div>

    </main>

    <footer class="footer">

        <div class="footer-content">
            <p>&copy; 2026 LearnLink. All rights reserved.</p>
        </div>

    </footer>

    <script>
        document.querySelector('.navbar-toggle').addEventListener('click', function () {
            document.querySelector('.navbar-menu').classList.toggle('active');
        });
    </script>

</body>
</html>
