@model LearnLink.Models.QuizQuestion

@{
    ViewBag.Title = "Upload Quiz Questions";
    Layout = null;
    string userRole = Session["UserRole"] != null ? Session["UserRole"].ToString() : "";
    string userName = Session["UserName"] != null ? Session["UserName"].ToString() : "Guest";
}

@if (TempData["Alert"] != null)
{
    <script>
        window.addEventListener('DOMContentLoaded', function () {
            alert('@TempData["Alert"]');
        });
    </script>
}

@if (ViewBag.Message != null)
{
    @ViewBag.Message
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Quiz Questions - LearnLink</title>
    <link href="@Url.Content("~/Content/CreateCourse.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/UploadQuiz.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>
                <div class="logo-text-group">
                    <span class="logo-text">LearnLink</span>
                    <span class="role-badge">@userRole</span>
                </div>
            </div>

            <div class="navbar-menu">
                <div class="nav-links">
                    @if (userRole.Equals("Student"))
                    {
                        <a href="@Url.Action("AllCourse", "AllCourse")" class="nav-link">
                            <ion-icon name="book-outline"></ion-icon>
                            <span>All Courses</span>
                        </a>
                        <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")" class="nav-link">
                            <ion-icon name="school-outline"></ion-icon>
                            <span>Enrolled Courses</span>
                        </a>
                        <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            <span>Assessments</span>
                        </a>
                        <a href="@Url.Action("editStudentProfile", "editStudentProfile")" class="nav-link">
                            <ion-icon name="person-outline"></ion-icon>
                            <span>Edit Profile</span>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("ManageCourse", "ManageCourse")" class="nav-link">
                            <ion-icon name="book-outline"></ion-icon>
                            <span>Manage Courses</span>
                        </a>
                        <a href="@Url.Action("createCourse", "createCourse")" class="nav-link">
                            <ion-icon name="add-circle-outline"></ion-icon>
                            <span>Create Courses</span>
                        </a>
                        <a href="@Url.Action("courseMaterials", "courseMaterials")" class="nav-link">
                            <ion-icon name="document-text-outline"></ion-icon>
                            <span>Course Materials</span>
                        </a>
                        <a href="@Url.Action("enrollStudents", "enrollStudents")" class="nav-link">
                            <ion-icon name="person-add-outline"></ion-icon>
                            <span>Enroll Students</span>
                        </a>
                        <a href="@Url.Action("Assessment", "Assessment")" class="nav-link active">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            <span>Assessments</span>
                        </a>
                        <a href="@Url.Action("editteacherProfile", "editteacherProfile")" class="nav-link">
                            <ion-icon name="person-outline"></ion-icon>
                            <span>Edit Profile</span>
                        </a>
                    }
                </div>
            </div>

            <div class="navbar-user">
                <div class="user-info">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <span class="user-name">@userName</span>
                </div>
                <a href="@Url.Action("Logout", "Logout")" class="logout-btn" title="Log Out">
                    <ion-icon name="log-out-outline"></ion-icon>
                </a>
            </div>

            <div class="navbar-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main-content">
        <div class="page-container">

            <!-- Page Header -->
            <div class="page-header-title">
                <h1>Upload Quiz Question</h1>
                <p>Add a new multiple-choice question to your quiz</p>
            </div>

            <!-- Form Section -->
            <div class="form-wrapper">
                @using (Html.BeginForm("UploadQuiz", "CreateQuiz", FormMethod.Post))
                {
                    <!-- Question Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <div class="card-icon-wrapper">
                                <ion-icon name="help-circle-outline"></ion-icon>
                            </div>
                            <div class="card-title-group">
                                <h2>Question Details</h2>
                                <p>Enter the question and provide four options</p>
                            </div>
                        </div>

                        <div class="card-body">
                            <!-- Quiz ID (hidden) -->
                            @Html.HiddenFor(m => m.QuizID)

                            <!-- Question Text -->
                            <div class="form-group">
                                <div class="form-field-header">
                                    <label for="Question" class="form-label">Question</label>
                                    <span class="required-badge">Required</span>
                                </div>
                                <textarea id="Question" 
                                          name="Question" 
                                          class="form-textarea" 
                                          placeholder="Enter your question here..."
                                          required></textarea>
                                <p class="field-hint">Be clear and specific with your question</p>
                            </div>

                            <!-- Options Grid -->
                            <div class="options-section">
                                <h3 class="section-subtitle">Answer Options</h3>

                                <div class="options-grid">
                                    <!-- Option A -->
                                    <div class="form-group">
                                        <div class="form-field-header">
                                            <label for="OptionA" class="form-label">Option A</label>
                                            <span class="required-badge">Required</span>
                                        </div>
                                        <input type="text" 
                                               id="OptionA" 
                                               name="OptionA" 
                                               class="form-input" 
                                               placeholder="Enter option A"
                                               required />
                                    </div>

                                    <!-- Option B -->
                                    <div class="form-group">
                                        <div class="form-field-header">
                                            <label for="OptionB" class="form-label">Option B</label>
                                            <span class="required-badge">Required</span>
                                        </div>
                                        <input type="text" 
                                               id="OptionB" 
                                               name="OptionB" 
                                               class="form-input" 
                                               placeholder="Enter option B"
                                               required />
                                    </div>

                                    <!-- Option C -->
                                    <div class="form-group">
                                        <div class="form-field-header">
                                            <label for="OptionC" class="form-label">Option C</label>
                                            <span class="required-badge">Required</span>
                                        </div>
                                        <input type="text" 
                                               id="OptionC" 
                                               name="OptionC" 
                                               class="form-input" 
                                               placeholder="Enter option C"
                                               required />
                                    </div>

                                    <!-- Option D -->
                                    <div class="form-group">
                                        <div class="form-field-header">
                                            <label for="OptionD" class="form-label">Option D</label>
                                            <span class="required-badge">Required</span>
                                        </div>
                                        <input type="text" 
                                               id="OptionD" 
                                               name="OptionD" 
                                               class="form-input" 
                                               placeholder="Enter option D"
                                               required />
                                    </div>
                                </div>
                            </div>

                            <!-- Correct Answer -->
                            <div class="form-group">
                                <div class="form-field-header">
                                    <label class="form-label">Select Correct Answer</label>
                                    <span class="required-badge">Required</span>
                                </div>
                                <div class="radio-group">
                                    <label class="radio-label">
                                        <input type="radio" name="CorrectOption" value="A" required />
                                        <span>Option A</span>
                                    </label>
                                    <label class="radio-label">
                                        <input type="radio" name="CorrectOption" value="B" />
                                        <span>Option B</span>
                                    </label>
                                    <label class="radio-label">
                                        <input type="radio" name="CorrectOption" value="C" />
                                        <span>Option C</span>
                                    </label>
                                    <label class="radio-label">
                                        <input type="radio" name="CorrectOption" value="D" />
                                        <span>Option D</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="form-actions">
                        <button type="submit" class="btn-primary">
                            <ion-icon name="cloud-upload-outline"></ion-icon>
                            <span>Submit Question</span>
                        </button>
                        <a href="@Url.Action("Assessment", "Assessment")" class="btn-secondary">
                            <ion-icon name="arrow-back-outline"></ion-icon>
                            <span>Cancel</span>
                        </a>
                    </div>
                }
            </div>

        </div>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2024 LearnLink. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Mobile menu toggle
        document.addEventListener('DOMContentLoaded', function() {
            var toggleBtn = document.querySelector('.navbar-toggle');
            var menu = document.querySelector('.navbar-menu');
            if (toggleBtn !== null && menu !== null) {
                toggleBtn.addEventListener('click', function () {
                    if (menu !== null) {
                        menu.classList.toggle('active');
                    }
                });
            }
        });
    </script>

</body>
</html>
                    
