@using LearnLink.Models;

@{
    ViewBag.Title = "Create Quiz";
    Layout = null;
    string userRole = Session["UserRole"] != null ? Session["UserRole"].ToString() : "";
    string userName = Session["UserName"] != null ? Session["UserName"].ToString() : "Guest";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Quiz - LearnLink</title>
    <link href="@Url.Content("/Content/dashboard.css")" rel="stylesheet" />
    <link href="@Url.Content("/Content/backbutton2.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/CreateCourse.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/CreateQuiz.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>
    <!-- ================= NAVBAR ================= -->
    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>
                <div class="logo-text-group">
                    <span class="logo-text">LearnLink</span>
                    <span class="role-badge">@userRole</span>
                </div>
            </div>

            <div class="navbar-menu">
                <div class="nav-links">
                    @if (userRole.Equals("Student"))
                    {
                        <a href="@Url.Action("AllCourse", "AllCourse")" class="nav-link">
                            <ion-icon name="book-outline"></ion-icon>
                            <span>All Courses</span>
                        </a>
                        <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")" class="nav-link">
                            <ion-icon name="school-outline"></ion-icon>
                            <span>Enrolled Courses</span>
                        </a>
                        <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            <span>Assessments</span>
                        </a>
                        <a href="@Url.Action("editStudentProfile", "editStudentProfile")" class="nav-link">
                            <ion-icon name="person-outline"></ion-icon>
                            <span>Edit Profile</span>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("ManageCourse", "ManageCourse")" class="nav-link">
                            <ion-icon name="book-outline"></ion-icon>
                            <span>Manage Courses</span>
                        </a>
                        <a href="@Url.Action("createCourse", "createCourse")" class="nav-link">
                            <ion-icon name="add-circle-outline"></ion-icon>
                            <span>Create Courses</span>
                        </a>
                        <a href="@Url.Action("courseMaterials", "courseMaterials")" class="nav-link">
                            <ion-icon name="document-text-outline"></ion-icon>
                            <span>Course Materials</span>
                        </a>
                        <a href="@Url.Action("enrollStudents", "enrollStudents")" class="nav-link">
                            <ion-icon name="person-add-outline"></ion-icon>
                            <span>Enroll Students</span>
                        </a>
                        <a href="@Url.Action("Assessment", "Assessment")" class="nav-link active">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            <span>Assessments</span>
                        </a>
                        <a href="@Url.Action("editteacherProfile", "editteacherProfile")" class="nav-link">
                            <ion-icon name="person-outline"></ion-icon>
                            <span>Edit Profile</span>
                        </a>
                    }
                </div>
            </div>

            <div class="navbar-user">
                <div class="user-info">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <span class="user-name">@userName</span>
                </div>
                <a href="@Url.Action("Logout", "Logout")" class="logout-btn" title="Log Out">
                    <ion-icon name="log-out-outline"></ion-icon>
                </a>
            </div>

            <div class="navbar-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main-content">
        <div class="page-container">

            <div class="app-body-content">
                    <div style="max-width: 800px; margin: 40px auto; padding: 0 20px;">
                        <div class="card-container">
                            <div class="card-header">
                                <h1>Create New Quiz</h1>
                                <p>Design a quiz for your course assessments</p>
                            </div>

                            <form action="@Url.Action("CreateQuiz", "CreateQuiz")" method="post">
                                <div class="form-section">
                                    <h3 class="section-title">Quiz Information</h3>

                                    <div class="form-row full">
                                        <div class="form-group required">
                                            <label for="CourseID">Course ID</label>
                                            <div class="input-wrapper">
                                                <span class="input-icon"><ion-icon name="book-outline"></ion-icon></span>
                                                <input type="text" id="CourseID" name="CourseID" placeholder="Select a course ID" value="@Request["courseID"]" required>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-row full">
                                        <div class="form-group required">
                                            <label for="Title">Quiz Title</label>
                                            <div class="input-wrapper">
                                                <span class="input-icon"><ion-icon name="document-text-outline"></ion-icon></span>
                                                <input type="text" id="Title" name="Title" placeholder="e.g., Chapter 1 Assessment" required>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-row full">
                                        <div class="form-group">
                                            <label for="Description">Description</label>
                                            <div class="input-wrapper">
                                                <textarea id="Description" name="Description" placeholder="Add quiz instructions or description..." required></textarea>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-row">
                                        <div class="form-group required">
                                            <label for="Duration">Duration (minutes)</label>
                                            <div class="input-wrapper">
                                                <span class="input-icon"><ion-icon name="time-outline"></ion-icon></span>
                                                <input type="number" id="Duration" name="Duration" placeholder="45" min="1" required>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="btn-group centered">
                                    <button type="submit" name="create" class="btn-primary">
                                        <ion-icon name="add-circle-outline"></ion-icon>
                                        Create Quiz
                                    </button>
                                    <a href="@Url.Action("Assessment", "Assessment")" class="btn-secondary">
                                        <ion-icon name="arrow-back-outline"></ion-icon>
                                        Cancel
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2024 LearnLink. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Mobile menu toggle  
        document.addEventListener('DOMContentLoaded', function() {
            var toggleBtn = document.querySelector('.navbar-toggle');
            var menu = document.querySelector('.navbar-menu');
            if (toggleBtn !== null && menu !== null) {
                toggleBtn.addEventListener('click', function () {
                    menu.classList.toggle('active');
                });
            }
        });
    </script>

</body>
</html>
