@{
    ViewBag.Title = "Create Course";
    Layout = null;
    string userRole = Session["UserRole"] != null ? Session["UserRole"].ToString() : "";
    string userName = Session["UserName"] != null ? Session["UserName"].ToString() : "Guest";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Course - LearnLink</title>
    <link href="@Url.Content("~/Content/CreateCourse.css")" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body>

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar">
        <div class="navbar-container">

            <div class="navbar-logo">
                <ion-icon name="school-outline" class="logo-icon"></ion-icon>
                <div class="logo-text-group">
                    <span class="logo-text">LearnLink</span>
                    <span class="role-badge">@userRole</span>
                </div>
            </div>

            <div class="navbar-menu">
                <div class="nav-links">
                    @if (userRole.Equals("Student"))
                    {
                        <a href="@Url.Action("AllCourse", "AllCourse")" class="nav-link">
                            <ion-icon name="book-outline"></ion-icon>
                            <span>All Courses</span>
                        </a>
                        <a href="@Url.Action("ViewEnrolledCourses", "StudentEnrolledCourses")" class="nav-link">
                            <ion-icon name="school-outline"></ion-icon>
                            <span>Enrolled Courses</span>
                        </a>
                        <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            <span>Assessments</span>
                        </a>
                        <a href="@Url.Action("editStudentProfile", "editStudentProfile")" class="nav-link">
                            <ion-icon name="person-outline"></ion-icon>
                            <span>Edit Profile</span>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("ManageCourse", "ManageCourse")" class="nav-link">
                            <ion-icon name="book-outline"></ion-icon>
                            <span>Manage Courses</span>
                        </a>
                        <a href="@Url.Action("createCourse", "createCourse")" class="nav-link active">
                            <ion-icon name="add-circle-outline"></ion-icon>
                            <span>Create Courses</span>
                        </a>
                        <a href="@Url.Action("courseMaterials", "courseMaterials")" class="nav-link">
                            <ion-icon name="document-text-outline"></ion-icon>
                            <span>Course Materials</span>
                        </a>
                        <a href="@Url.Action("enrollStudents", "enrollStudents")" class="nav-link">
                            <ion-icon name="person-add-outline"></ion-icon>
                            <span>Enroll Students</span>
                        </a>
                        <a href="@Url.Action("Assessment", "Assessment")" class="nav-link">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            <span>Assessments</span>
                        </a>
                        <a href="@Url.Action("editteacherProfile", "editteacherProfile")" class="nav-link">
                            <ion-icon name="person-outline"></ion-icon>
                            <span>Edit Profile</span>
                        </a>
                    }
                </div>
            </div>

            <div class="navbar-user">
                <div class="user-info">
                    <ion-icon name="person-circle" class="user-avatar"></ion-icon>
                    <span class="user-name">@userName</span>
                </div>
                <a href="@Url.Action("Logout", "Logout")" class="logout-btn" title="Log Out">
                    <ion-icon name="log-out-outline"></ion-icon>
                </a>
            </div>

            <div class="navbar-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>

        </div>
    </nav>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="main-content">
        <div class="page-container">

            <!-- Page Header -->
            <div class="page-header-title">
                <h1>Create New Course</h1>
                <p>Design and publish a new course for your students.</p>
            </div>

            <!-- Form Section -->
            <div class="form-wrapper">
                @using (Html.BeginForm("CreateCourse", "createCourse", FormMethod.Post))
                {
                    <!-- Course Information Card -->
                    <div class="form-card">
                        <div class="card-header">
                            <div class="card-icon-wrapper">
                                <ion-icon name="book-outline"></ion-icon>
                            </div>
                            <div class="card-title-group">
                                <h2>Course Information</h2>
                                <p>Provide the basic details about your course</p>
                            </div>
                        </div>

                        <div class="card-body">
                            <!-- Course Name -->
                            <div class="form-group">
                                <div class="form-field-header">
                                    <label for="CourseName" class="form-label">Course Name</label>
                                    <span class="required-badge">Required</span>
                                </div>
                                <input type="text"
                                       id="CourseName"
                                       name="CourseName"
                                       class="form-input"
                                       placeholder="e.g., Introduction to C# Programming"
                                       required>
                                <p class="field-hint">Choose a clear and descriptive name</p>
                            </div>

                            <!-- Course Description -->
                            <div class="form-group">
                                <div class="form-field-header">
                                    <label for="CourseDescription" class="form-label">Course Description</label>
                                    <span class="required-badge">Required</span>
                                </div>
                                <textarea id="CourseDescription"
                                          name="CourseDescription"
                                          class="form-textarea"
                                          placeholder="Describe what students will learn..."
                                          rows="4"
                                          required></textarea>
                                <p class="field-hint">Provide a comprehensive overview of the course content</p>
                            </div>

                            <!-- Course Prerequisites -->
                            <div class="form-group">
                                <div class="form-field-header">
                                    <label for="CoursePrerequisite" class="form-label">Prerequisites</label>
                                    <span class="optional-badge">Optional</span>
                                </div>
                                <input type="text"
                                       id="CoursePrerequisite"
                                       name="CoursePrerequisite"
                                       class="form-input"
                                       placeholder="e.g., Basic Programming Knowledge, Mathematics Fundamentals">
                                <p class="field-hint">List any prerequisites students should have before enrolling</p>
                            </div>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="form-actions">
                        <button type="submit" class="btn-primary">
                            <ion-icon name="checkmark-circle-outline"></ion-icon>
                            <span>Create Course</span>
                        </button>
                        <a href="@Url.Action("ManageCourse", "ManageCourse")" class="btn-secondary">
                            <ion-icon name="arrow-back-outline"></ion-icon>
                            <span>Cancel</span>
                        </a>
                    </div>
                }
            </div>

        </div>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2024 LearnLink. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Mobile menu toggle
        document.querySelector('.navbar-toggle').addEventListener('click', function () {
            document.querySelector('.navbar-menu').classList.toggle('active');
        });
    </script>

</body>
</html>
