@{
    var alertMessage = TempData["AlertMessage"] as string;
}

<!-- Forgot Password view fragment - shared layout provides head/scripts -->
<main class="auth-container">
    <script type="text/javascript">
        window.onload = function() {
            var alertMessage = '@alertMessage';
            if (alertMessage) {
                alert(alertMessage);
                window.location.href = '@Url.Action("reg", "Registration")';
            }
        };
    </script>

    <div class="auth-content">
        <!-- Left Section: Information -->
        <div class="auth-left-section">
            <div class="auth-branding">
                <h1>Reset Password</h1>
                <p>Recover Your Account</p>
                <div class="auth-features">
                    <div class="feature-item">
                        <ion-icon name="shield-checkmark-outline"></ion-icon>
                        <span>Secure Recovery Process</span>
                    </div>
                    <div class="feature-item">
                        <ion-icon name="checkmark-circle-outline"></ion-icon>
                        <span>Quick & Simple</span>
                    </div>
                    <div class="feature-item">
                        <ion-icon name="lock-open-outline"></ion-icon>
                        <span>Regain Access Instantly</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Section: Form -->
        <div class="auth-right-section">
            <div class="auth-form-container">
                <!-- Form -->
                <form action="" method="post" class="auth-form">
                    <!-- Role Selection Toggle (inside form so it posts) -->
                    <div class="auth-role-selector">
                        <p class="role-label">Account type</p>
                        <div class="role-toggle-container">
                            <input type="radio" id="role-teacher" name="Role" value="teacher" checked>
                            <label for="role-teacher" class="role-toggle-btn">
                                <ion-icon name="school-outline"></ion-icon>
                                <span>Teacher</span>
                            </label>

                            <input type="radio" id="role-student" name="Role" value="student">
                            <label for="role-student" class="role-toggle-btn">
                                <ion-icon name="person-outline"></ion-icon>
                                <span>Student</span>
                            </label>
                        </div>
                    </div>

                    <h2>Reset Your Password</h2>

                    <!-- Verification Section -->
                    <div class="form-section">
                        <h3 class="section-title">Account Verification</h3>
                        <div class="form-group">
                            <label for="Email">Email Address</label>
                            <div class="input-wrapper">
                                <span class="input-icon"><ion-icon name="mail-outline"></ion-icon></span>
                                <input type="email" id="Email" name="Email" placeholder="your@example.com" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="PIN">Personal PIN</label>
                            <div class="input-wrapper">
                                <span class="input-icon"><ion-icon name="key-outline"></ion-icon></span>
                                <input type="password" id="PIN" name="PIN" placeholder="Enter your PIN" required>
                            </div>
                        </div>
                        <p class="section-hint">Enter your PIN to verify your identity</p>
                    </div>

                    <!-- New Password Section -->
                    <div class="form-section">
                        <h3 class="section-title">New Password</h3>
                        <div class="form-group">
                            <label for="Password">New Password</label>
                            <div class="input-wrapper">
                                <span class="input-icon"><ion-icon name="lock-closed-outline"></ion-icon></span>
                                <input type="password" id="Password" name="Password" placeholder="Create a new password" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="ConfirmPassword">Confirm Password</label>
                            <div class="input-wrapper">
                                <span class="input-icon"><ion-icon name="lock-closed-outline"></ion-icon></span>
                                <input type="password" id="ConfirmPassword" name="ConfirmPassword" placeholder="Re-enter your password" required>
                            </div>
                        </div>
                    </div>

                    <button type="submit" name="login" class="btn-primary">Reset Password</button>
                </form>

                <!-- Login Link -->
                <div class="auth-footer-link">
                    <p>Remember your password? <a href="@Url.Action("login", "Login")">Sign in here</a></p>
                </div>
            </div>
        </div>
    </div>
</main>
