@{
    ViewBag.Title = "Reset Password";
    var alertMessage = TempData["AlertMessage"] as string;
    var role = ViewBag.Role as string;
    var token = ViewBag.Token as string;
}

<main class="auth-container">
    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <script type="text/javascript">
            window.onload = function() {
                alert(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(alertMessage)));
            };
        </script>
    }

    <div class="auth-content">
        <div class="auth-left-section">
            <div class="auth-branding">
                <h1>New Password</h1>
                <p>Secure Your Account</p>
                <div class="auth-features">
                    <div class="feature-item">
                        <ion-icon name="shield-checkmark-outline"></ion-icon>
                        <span>Secure Recovery Process</span>
                    </div>
                    <div class="feature-item">
                        <ion-icon name="checkmark-circle-outline"></ion-icon>
                        <span>Quick & Simple</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-right-section">
            <div class="auth-form-container">
                <form action="@Url.Action("ResetPassword", "forgotPassword")" method="post" class="auth-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="role" value="@role" />
                    <input type="hidden" name="token" value="@token" />

                    <h2>Set New Password</h2>

                    <div class="form-section">
                        <h3 class="section-title">New Password</h3>
                        <div class="form-group">
                            <label for="Password">New Password</label>
                            <div class="input-wrapper">
                                <span class="input-icon"><ion-icon name="lock-closed-outline"></ion-icon></span>
                                <input type="password" id="Password" name="Password" placeholder="Create a new password" required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="ConfirmPassword">Confirm Password</label>
                            <div class="input-wrapper">
                                <span class="input-icon"><ion-icon name="lock-closed-outline"></ion-icon></span>
                                <input type="password" id="ConfirmPassword" name="ConfirmPassword" placeholder="Re-enter your password" required />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn-primary">Update Password</button>
                </form>

                <div class="auth-footer-link">
                    <p>Remember your password? <a href="@Url.Action("login", "Login")">Sign in here</a></p>
                </div>
            </div>
        </div>
    </div>
</main>